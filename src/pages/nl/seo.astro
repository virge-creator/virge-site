---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import SeoAdviceForm from '../../components/SeoAdviceForm.astro';
import SeoPlansModal from '../../components/SeoPlansModal.astro';
import { t } from '../../i18n';
import { PLANS, formatEuro } from '../../data/seo';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/structured-data';

const lang = 'nl';
const i = t(lang);
const s = i.seo;
const reportIcons = ['gauge', 'search', 'star', 'bot', 'users', 'list-checks'];

const jsonLd = [
  serviceSchema({ name: 'SEO-advies', description: s.metaDesc, path: `/${lang}/seo/` }),
  breadcrumbSchema([
    { name: i.nav.home, path: `/${lang}/` },
    { name: i.nav.services, path: `/${lang}/services/` },
    { name: i.nav.seo, path: `/${lang}/seo/` },
  ]),
  faqSchema(s.faq),
];
---
<Layout title={s.metaTitle} description={s.metaDesc} lang={lang} jsonLd={jsonLd}>
  <div class="page-back">
    <a href={`/${lang}/services/`} class="back-link">{i.nav.backToServices}</a>
  </div>
  <div class="page-header">
    <h1><Fragment set:html={s.title} /></h1>
    <p>{s.description}</p>
  </div>

  <section>
    <div class="container seo-intro">
      <div class="seo-report">
        <h2>{s.reportTitle}</h2>
        <p class="seo-lead">{s.reportIntro}</p>
        <ul class="seo-report-list">
          {s.reportItems.map((item, idx) => (
            <li>
              <span class="seo-report-icon"><Icon name={reportIcons[idx]} size={20} /></span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="seo-free" id="free">
        <span class="seo-free-badge"><Icon name="sparkles" size={14} /> {s.freeBadge}</span>
        <h2>{s.freeTitle}</h2>
        <p class="seo-lead">{s.freeDesc}</p>
        <SeoAdviceForm lang={lang} />
      </div>
    </div>
  </section>

  <section class="seo-plans-section">
    <div class="container">
      <h2>{s.plansTitle}</h2>
      <p class="seo-lead">{s.plansIntro}</p>
      <div class="seo-price-cards">
        {PLANS.map((plan) => {
          const copy = s.plans[plan.id];
          return (
            <div class:list={['seo-price-card', { 'seo-price-card--popular': plan.popular }]}>
              {plan.popular && <span class="seo-price-tag">{s.popular}</span>}
              <h3>{copy.name}</h3>
              <p class="seo-price-freq">{copy.frequency}</p>
              <p class="seo-price-amount">
                <strong>{formatEuro(plan.prices.month, lang)}</strong>{s.perMonth}
                <span>{formatEuro(plan.prices.year, lang)}{s.perYear} ({s.yearBadge.toLowerCase()})</span>
              </p>
              <p class="seo-price-vat">{s.exVat}</p>
              <p class="seo-price-desc">{copy.desc}</p>
              <button type="button" class="btn" data-open-plans data-plan={plan.id}>{s.choosePlan}</button>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <FAQ items={s.faq} lang={lang} />
  <div class="container"><CTA lang={lang} /></div>
  <SeoPlansModal lang={lang} />
</Layout>

<style>
  .seo-intro {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start;
  }
  @media (max-width: 900px) { .seo-intro { grid-template-columns: 1fr; gap: 2.5rem; } }

  .seo-intro h2, .seo-plans-section h2 { font-size: 1.7rem; margin-bottom: 0.5rem; }
  .seo-lead { color: var(--text-muted); margin-bottom: 1.75rem; }

  .seo-report-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
  .seo-report-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .seo-report-icon {
    flex-shrink: 0; display: grid; place-items: center; width: 40px; height: 40px;
    border-radius: 10px; background: rgba(108,92,231,0.15); color: var(--link);
  }
  .seo-report-list h3 { font-size: 1.05rem; margin: 0 0 0.2rem; }
  .seo-report-list p { color: var(--text-muted); font-size: 0.93rem; margin: 0; }

  .seo-free {
    position: sticky; top: 6rem;
    padding: 2rem; border-radius: 16px;
    background: var(--bg-card);
    box-shadow: inset 0 0 0 1px rgba(168,85,247,0.3), 0 0 40px rgba(108,92,231,0.15);
  }
  @media (max-width: 900px) { .seo-free { position: static; padding: 1.5rem 1rem; } }
  .seo-free-badge {
    display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.75rem;
    padding: 0.2rem 0.7rem; border-radius: 50px; font-size: 0.78rem; font-weight: 700;
    background: rgba(52,211,153,0.15); color: #6ee7b7;
  }

  .seo-plans-section { padding-top: 4rem; }
  .seo-price-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.25rem;
  }
  .seo-price-card {
    position: relative; display: flex; flex-direction: column;
    padding: 1.75rem; border-radius: var(--radius);
    background: var(--bg-card); box-shadow: inset 0 0 0 1px rgba(108,92,231,0.25);
  }
  .seo-price-card--popular {
    background: linear-gradient(180deg, #4833b8 0%, #5d46d8 34%, #376dd9 68%, #2593e5 100%);
    box-shadow: inset 0 0 0 1.5px rgba(255,255,255,0.2);
  }
  .seo-price-tag {
    position: absolute; top: 1.25rem; right: 1.25rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.2rem 0.6rem; border-radius: 50px; background: rgba(255,255,255,0.2); color: #fff;
  }
  .seo-price-card h3 { font-size: 1.4rem; margin: 0; }
  .seo-price-freq { color: var(--text-muted); margin: 0.2rem 0 1rem; }
  .seo-price-amount { margin: 0; color: var(--text-muted); }
  .seo-price-amount strong { font-size: 2.4rem; color: var(--text); margin-right: 0.15rem; }
  .seo-price-amount span { display: block; font-size: 0.9rem; }
  .seo-price-vat { font-size: 0.78rem; color: var(--text-muted); opacity: 0.85; margin: 0.15rem 0 1rem; }
  .seo-price-desc { color: var(--text-muted); font-size: 0.93rem; margin-bottom: 1.5rem; }
  .seo-price-card--popular .seo-price-freq,
  .seo-price-card--popular .seo-price-amount,
  .seo-price-card--popular .seo-price-vat,
  .seo-price-card--popular .seo-price-desc { color: rgba(255,255,255,0.85); }
  .seo-price-card--popular .seo-price-amount strong { color: #fff; }
  .seo-price-card .btn { margin-top: auto; align-self: flex-start; }
  .seo-price-card--popular .btn { background: #fff; color: #3b2aa8; }
  .seo-price-card--popular .btn:hover { background: #ede9ff; }
</style>
