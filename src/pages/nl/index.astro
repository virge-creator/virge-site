---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'nl';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
        <a href={`/${lang}/services/`} class="btn-ghost">Onze diensten →</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="services-inner">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Gebouwd voor schaal,<br/>ontworpen voor de praktijk.</h2>
      </div>

      <div class="service-grid">

        <!-- 1: AI cluster — card + points + case study -->
        <div class="svc-cluster svc-ai">
          <div class="svc-row">
            <a href={`/${lang}/ai/`} class="scard reveal-card" style="--ghost: 'AI'; --delay: 0s">
              <div class="scard-top"><span class="scard-num">01</span><span class="scard-arrow">→</span></div>
              <h3>{i.home.aiTitle}</h3>
              <p>{i.home.aiDesc}</p>
            </a>
            <div class="svc-points reveal-card" style="--delay: 0.07s">
              <p class="svc-points-lead">Wat we leveren</p>
              <ul class="svc-points-list">
                <li>Vector databases &amp; RAG</li>
                <li>AI-integratie</li>
                <li>Productiesystemen</li>
                <li>Meetbare waarde</li>
              </ul>
            </div>
          </div>
          <a href={`/${lang}/blog/librechat-as-agent-orchestrator/`} class="cases-card reveal-card" style="--delay: 0.14s">
            <span class="cases-eyebrow">Case Study</span>
            <h4>WFO-agent opzetten met LibreChat: geen Kubernetes vereist</h4>
            <div class="cases-meta">
              <span>Jul 2026</span>
              <span class="cases-dot">·</span>
              <span>SDN · LibreChat</span>
            </div>
            <span class="cases-cta">Lees case →</span>
          </a>
        </div>

        <!-- 2: OpenClaw cluster — card + points -->
        <div class="svc-cluster">
          <div class="svc-row">
            <a href={`/${lang}/openclaw/`} class="scard reveal-card" style="--ghost: 'OC'; --delay: 0.08s">
              <div class="scard-top"><span class="scard-num">03</span><span class="scard-arrow">→</span></div>
              <h3>{i.home.openclawTitle}</h3>
              <p>{i.home.openclawDesc}</p>
            </a>
            <div class="svc-points reveal-card" style="--delay: 0.15s">
              <p class="svc-points-lead">Wat we bieden</p>
              <ul class="svc-points-list">
                <li>Self-hosted AI</li>
                <li>Managed hosting</li>
                <li>Beveiliging &amp; hardening</li>
                <li>Bedrijfsautomatisering</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 3: SDN cluster — card + points -->
        <div class="svc-cluster">
          <div class="svc-row">
            <a href={`/${lang}/sdn/`} class="scard reveal-card" style="--ghost: 'SDN'; --delay: 0.16s">
              <div class="scard-top"><span class="scard-num">04</span><span class="scard-arrow">→</span></div>
              <h3>{i.home.sdnTitle}</h3>
              <p>{i.home.sdnDesc}</p>
            </a>
            <div class="svc-points reveal-card" style="--delay: 0.23s">
              <p class="svc-points-lead">Wat we leveren</p>
              <ul class="svc-points-list">
                <li>Netwerkautomatisering</li>
                <li>Workflow Orchestrator</li>
                <li>Infrastructure as Code</li>
                <li>Enterprise integratie</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 4: eCommerce cluster — card + carousel (full-width bottom) -->
        <div class="ec-cluster">
          <a href={`/${lang}/ecommerce/`} class="scard reveal-card" style="--ghost: 'EC'; --delay: 0.24s">
            <div class="scard-top"><span class="scard-num">02</span><span class="scard-arrow">→</span></div>
            <h3>{i.home.ecomTitle}</h3>
            <p>{i.home.ecomDesc}</p>
          </a>
          <div class="ec-carousel">
            <a href={`/${lang}/ecommerce/`} class="ec-slide">
              <span class="ec-slide-tag">Productcontent</span>
              <h4>Content as a Service</h4>
              <p>AI-gegenereerde productbeschrijvingen op schaal.</p>
            </a>
            <a href={`/${lang}/ecommerce/`} class="ec-slide">
              <span class="ec-slide-tag">Webshop</span>
              <h4>ShopVirge</h4>
              <p>Volledige webshop in dagen, niet maanden.</p>
            </a>
            <a href={`/${lang}/ecommerce/`} class="ec-slide">
              <span class="ec-slide-tag">Integraties</span>
              <h4>Verbind je stack</h4>
              <p>ERP, CRM, fulfilment &amp; marketing in één flow.</p>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));

  // Draw unified L-shape border for AI cluster
  function drawAiBorder() {
    const cluster = document.querySelector('.svc-ai');
    if (!cluster) return;
    const scard = cluster.querySelector('.scard');
    const cc = cluster.querySelector('.cases-card');
    if (!scard || !cc) return;

    const cr = cluster.getBoundingClientRect();
    const sr = scard.getBoundingClientRect();
    const ccr = cc.getBoundingClientRect();

    const s = { l: sr.left - cr.left, t: sr.top - cr.top, r: sr.right - cr.left, b: sr.bottom - cr.top };
    const c = { l: ccr.left - cr.left, t: ccr.top - cr.top, r: ccr.right - cr.left, b: ccr.bottom - cr.top };

    const R = 12;
    const d = [
      `M ${s.l + R} ${s.t}`,
      `L ${s.r - R} ${s.t}`,
      `A ${R} ${R} 0 0 1 ${s.r} ${s.t + R}`,
      `L ${s.r} ${s.b - R}`,
      `A ${R} ${R} 0 0 1 ${s.r - R} ${s.b}`,
      `L ${c.r} ${s.b}`,
      `L ${c.r} ${c.b - R}`,
      `A ${R} ${R} 0 0 1 ${c.r - R} ${c.b}`,
      `L ${c.l + R} ${c.b}`,
      `A ${R} ${R} 0 0 1 ${c.l} ${c.b - R}`,
      `L ${c.l} ${c.t + R}`,
      `A ${R} ${R} 0 0 1 ${c.l + R} ${c.t}`,
      `L ${s.l} ${c.t}`,
      `L ${s.l} ${s.t + R}`,
      `A ${R} ${R} 0 0 1 ${s.l + R} ${s.t}`,
      'Z'
    ].join(' ');

    let svg = cluster.querySelector('.ai-border-svg');
    if (!svg) {
      svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.classList.add('ai-border-svg');

      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      const grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
      grad.id = 'ai-border-grad';
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');
      const s1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      s1.setAttribute('offset', '0%'); s1.setAttribute('stop-color', '#6c5ce7');
      const s2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
      s2.setAttribute('offset', '100%'); s2.setAttribute('stop-color', '#2593e5');
      grad.appendChild(s1); grad.appendChild(s2);
      defs.appendChild(grad);
      svg.appendChild(defs);

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.classList.add('ai-border-path');
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', 'url(#ai-border-grad)');
      path.setAttribute('stroke-width', '1');
      svg.appendChild(path);
      cluster.prepend(svg);
    }

    const grad = svg.querySelector('linearGradient');
    grad.setAttribute('x1', s.r); grad.setAttribute('y1', s.t);
    grad.setAttribute('x2', c.l); grad.setAttribute('y2', c.b);

    svg.querySelector('.ai-border-path').setAttribute('d', d);
  }
  drawAiBorder();
  window.addEventListener('resize', drawAiBorder);

  // Unified glow overlay for AI cluster
  const aiCluster = document.querySelector('.svc-ai');
  if (aiCluster) {
    const glow = document.createElement('div');
    glow.className = 'ai-glow-overlay';
    aiCluster.appendChild(glow);
    aiCluster.addEventListener('mousemove', (e) => {
      const r = glow.getBoundingClientRect();
      glow.style.setProperty('--mx', `${e.clientX - r.left}px`);
      glow.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  }

  document.querySelectorAll('.scard, .cases-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services section ---- */
  .services-section { padding: 6rem 0 5rem; overflow: visible; }
  .services-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .section-intro { margin-bottom: 3.5rem; }
  .section-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  /* ---- Editorial grid (10 cols) ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    column-gap: 1.25rem;
    row-gap: 1.5rem;
    align-items: start;
    padding-bottom: 4rem;
  }

  /* 1 AI cluster: top-left (40%) */
  .service-grid > *:nth-child(1) { grid-column: 1 / 5; grid-row: 1; position: relative; z-index: 3; }
  /* 2 EC: top-right (60%), drops 1.5rem */
  .service-grid > *:nth-child(2) { grid-column: 5 / 11; grid-row: 1; margin-top: 1.5rem; }
  /* 3 OC: center-right, overlaps up */
  .service-grid > *:nth-child(3) {
    grid-column: 3 / 9;
    grid-row: 2;
    margin-top: -2.5rem;
    position: relative;
    z-index: 2;
  }
  /* 4 SDN: full width, row 3 */
  .service-grid > *:nth-child(4) { grid-column: 1 / 11; grid-row: 3; margin-top: 0.5rem; }

  /* ---- Service clusters (shared: AI, OC, SDN) ---- */
  .svc-cluster {
    display: flex;
    flex-direction: column;
    overflow: visible;
    position: relative;
  }
  .svc-row {
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    flex: 1;
  }
  .svc-row .scard {
    flex: 1;
    min-width: 0;
  }

  .svc-points {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0.25rem;
  }
  .svc-points-lead {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .svc-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .svc-points-list li {
    font-size: 0.83rem;
    color: var(--text-muted);
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    line-height: 1.4;
  }
  .svc-points-list li::before {
    content: '·';
    color: var(--accent2);
    font-size: 1rem;
    margin-top: 0;
    flex-shrink: 0;
  }

  /* ---- eCommerce cluster — card + scroll carousel ---- */
  .ec-cluster {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: visible;
  }
  .ec-carousel {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
  }
  .ec-carousel::-webkit-scrollbar { display: none; }
  .ec-slide {
    flex: 0 0 calc(50% - 0.44rem);
    scroll-snap-align: start;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.12);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .ec-slide:hover {
    border-color: rgba(108,92,231,0.35);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    text-decoration: none;
  }
  .ec-slide-tag {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.4rem;
  }
  .ec-slide h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.3rem;
    line-height: 1.3;
  }
  .ec-slide p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  /* ---- Cases card (overlapping offset below-left of the AI scard) ---- */
  .cases-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.35);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: 0 8px 28px rgba(0,0,0,0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    margin-top: -2.5rem;
    margin-left: -1.5rem;
    align-self: flex-start;
    width: 240px;
    position: relative;
    z-index: 3;
  }
  .cases-card h4 {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
    flex: 1;
  }
  .cases-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, -999px) var(--my, -999px),
      rgba(108,92,231,0.13),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    border-radius: inherit;
  }
  .cases-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(108,92,231,0.18);
    border-color: rgba(108,92,231,0.55);
    text-decoration: none;
  }
  .cases-card:hover::before { opacity: 1; }

  /* Remove individual borders — SVG draws the unified L-shape outline */
  .svc-ai .scard {
    border-color: transparent;
    box-shadow: none;
  }
  /* Suppress per-card spotlight — unified overlay handles it */
  .svc-ai .scard::before { display: none; }

  .cases-card {
    border-color: transparent;
    box-shadow: none;
    /* Top-right matches scard bg (seamless at overlap), bottom-left fades to blue */
    background: linear-gradient(to bottom left, var(--bg-card) 25%, rgba(37,147,229,0.18) 80%);
  }

  /* Single glow overlay that spans the full L-shape */
  .ai-glow-overlay {
    position: absolute;
    top: 0;
    left: -2rem;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 5;
    background: radial-gradient(320px circle at var(--mx, -9999px) var(--my, -9999px), rgba(108,92,231,0.13), transparent 65%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .svc-ai:hover .ai-glow-overlay { opacity: 1; }
  .ai-border-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    overflow: visible;
    pointer-events: none;
    z-index: 10;
  }
  .ai-border-path {
    fill: none;
    stroke-width: 1;
    opacity: 0.7;
    transition: opacity 0.25s ease;
  }
  .svc-ai:hover .ai-border-path {
    opacity: 1;
  }

  .cases-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
  }
  .cases-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: auto;
  }
  .cases-dot { opacity: 0.4; }
  .cases-cta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent2);
    margin-top: 0.25rem;
  }

  /* ---- Service cards ---- */
  .scard {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.12);
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .scard::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, -999px) var(--my, -999px),
      rgba(108,92,231,0.13),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    border-radius: inherit;
  }
  .scard:hover {
    border-color: rgba(108,92,231,0.35);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    text-decoration: none;
  }
  .scard:hover::before { opacity: 1; }
  .scard::after {
    content: var(--ghost, '');
    position: absolute;
    left: 1.5rem;
    bottom: 0.75rem;
    font-size: 6.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: rgba(108,92,231,0.07);
    pointer-events: none;
    user-select: none;
  }
  .scard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .scard-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent2);
    opacity: 0.7;
  }
