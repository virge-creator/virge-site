---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'nl';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
        <a href={`/${lang}/services/`} class="btn-ghost">Onze diensten →</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="container">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Gebouwd voor schaal,<br/>ontworpen voor de praktijk.</h2>
      </div>

      <div class="service-grid">

        <!-- Featured: SDN + overlaid cases card -->
        <div class="featured-cluster reveal-card">
          <a href={`/${lang}/sdn/`} class="scard scard-featured">
            <div class="scard-top">
              <span class="scard-num">02</span>
              <span class="scard-arrow">→</span>
            </div>
            <h3>{i.home.sdnTitle}</h3>
            <p>{i.home.sdnDesc}</p>
          </a>
          <a href={`/${lang}/blog/librechat-as-agent-orchestrator/`} class="cases-card">
            <span class="cases-eyebrow">Case Study</span>
            <h4>WFO-agent opzetten met LibreChat: geen Kubernetes vereist</h4>
            <div class="cases-meta">
              <span>Jul 2026</span>
              <span class="cases-dot">·</span>
              <span>SDN · LibreChat</span>
            </div>
            <span class="cases-cta">Lees case →</span>
          </a>
        </div>

        <!-- Smaller cards -->
        <a href={`/${lang}/ai/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">01</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.aiTitle}</h3>
          <p>{i.home.aiDesc}</p>
        </a>
        <a href={`/${lang}/ecommerce/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">03</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.ecomTitle}</h3>
          <p>{i.home.ecomDesc}</p>
        </a>
        <a href={`/${lang}/openclaw/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">04</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.openclawTitle}</h3>
          <p>{i.home.openclawDesc}</p>
        </a>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services section ---- */
  .services-section { padding: 6rem 0 5rem; }
  .section-intro { margin-bottom: 3.5rem; }
  .section-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  /* ---- Grid ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ---- Featured cluster ---- */
  .featured-cluster {
    grid-column: 1 / 4;
    display: grid;
    grid-template-columns: 1fr 300px;
    padding-bottom: 2.5rem;
  }

  .scard-featured {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.15);
    border-radius: var(--radius) 0 0 var(--radius);
    padding: 2.25rem;
    min-height: 260px;
    transition: border-color 0.25s ease;
  }
  .scard-featured:hover {
    border-color: rgba(108,92,231,0.4);
    text-decoration: none;
  }
  .scard-featured::after {
    content: 'SDN';
    position: absolute;
    right: 2rem;
    bottom: 1rem;
    font-size: 7rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: rgba(108,92,231,0.055);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .cases-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    border: 1px solid rgba(108,92,231,0.35);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.75rem;
    position: relative;
    z-index: 2;
    transform: translate(-1px, 2.5rem);
    box-shadow: -6px 12px 36px rgba(0,0,0,0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .cases-card:hover {
    transform: translate(-1px, 1.5rem);
    box-shadow: -6px 20px 48px rgba(108,92,231,0.22);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }
  .cases-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
  }
  .cases-card h4 {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
    flex: 1;
  }
  .cases-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: auto;
  }
  .cases-dot { opacity: 0.4; }
  .cases-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent2);
    margin-top: 0.25rem;
  }

  /* ---- Small service cards ---- */
  .scard {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.15);
    border-radius: var(--radius);
    padding: 2rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .scard:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 48px rgba(108,92,231,0.18);
    border-color: rgba(108,92,231,0.45);
    text-decoration: none;
  }
  .scard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .scard-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent2);
    opacity: 0.7;
  }
  .scard-arrow {
    font-size: 1rem;
    color: var(--accent2);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .scard:hover .scard-arrow,
  .scard-featured:hover .scard-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .scard h3, .scard-featured h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text);
  }
  .scard p, .scard-featured p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Scroll reveal ---- */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .reveal.is-visible { opacity: 1; transform: none; }

  .reveal-card {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s ease, transform 0.55s ease,
                box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .reveal-card.is-visible { opacity: 1; transform: none; }
  .reveal-card:nth-child(1) { transition-delay: 0s; }
  .reveal-card:nth-child(2) { transition-delay: 0.08s; }
  .reveal-card:nth-child(3) { transition-delay: 0.16s; }
  .reveal-card:nth-child(4) { transition-delay: 0.24s; }

  .reveal-card.is-visible:hover { transform: translateY(-5px); }
  .reveal-card.is-visible.featured-cluster:hover { transform: none; }
  .reveal-card.is-visible .cases-card:hover { transform: translate(-1px, 1.5rem); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .service-grid { grid-template-columns: 1fr; }
    .featured-cluster {
      grid-column: 1;
      grid-template-columns: 1fr;
      padding-bottom: 0;
    }
    .scard-featured {
      border-radius: var(--radius) var(--radius) 0 0;
      min-height: auto;
    }
    .cases-card {
      border-radius: 0 0 var(--radius) var(--radius);
      transform: none;
      box-shadow: none;
    }
    .cases-card:hover { transform: none; }
  }
</style>
