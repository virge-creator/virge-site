---
import Layout from '../../layouts/Layout.astro';

// Theme and logo files live in public/styleguide/ and are generated by
// scripts/styleguide/build_slides_theme.py. Keep these colours in sync with it.
const palettes = [
  {
    name: 'Dark',
    note: 'Taken from the website.',
    colors: [
      ['Background', '#0a0a1a'],
      ['Card', '#12122a'],
      ['Title', '#ffffff'],
      ['Text', '#e0e0f0'],
      ['Muted', '#a1a1c4'],
      ['Purple', '#6c5ce7'],
      ['Violet', '#a855f7'],
      ['Link', '#c4a5ff'],
      ['Workflow Orchestrator', '#5cb8ff'],
      ['ShopVirge', '#e879f9'],
    ],
  },
  {
    name: 'Light',
    note: 'The website is dark only, so these are derived from it, with darker accents that stay readable on white.',
    colors: [
      ['Background', '#ffffff'],
      ['Card', '#f3f2fb'],
      ['Title', '#0a0a1a'],
      ['Text', '#2a2a4a'],
      ['Muted', '#55557a'],
      ['Purple', '#6c5ce7'],
      ['Violet', '#a855f7'],
      ['Link', '#5b3fd6'],
      ['Workflow Orchestrator', '#1565c0'],
      ['ShopVirge', '#c026d3'],
    ],
  },
];

const logos = [
  { file: 'virge-logo-on-dark.png', label: 'Logo for dark backgrounds', tone: 'dark' },
  { file: 'virge-logo-on-light.png', label: 'Logo for light backgrounds', tone: 'light' },
  { file: 'virge-mark.png', label: 'Cloud mark only', tone: 'dark' },
];
---
<Layout title="Style guide" description="Virge.io colours, logos, type and the Google Slides theme.">
  <header class="page-header">
    <h1>Style guide</h1>
    <p>The Virge colours, logos and type, and a slide theme for webinars.</p>
  </header>

  <div class="container sg">
    <section>
      <h2>Google Slides theme</h2>
      <p>Thirteen layouts in a dark and a light version. Mix them freely within one deck. Both include covers for Workflow Orchestrator and ShopVirge webinars, plus agenda, code, screenshot and speaker slides.</p>
      <p><a class="btn" href="/styleguide/slides/virge-slides-theme.pptx" download>Download the theme (.pptx)</a></p>

      <h3>Start a new deck</h3>
      <ol>
        <li>Upload the file to Google Drive and open it with Google Slides.</li>
        <li>Choose <strong>File → Save as Google Slides</strong>.</li>
        <li>Delete the sample slides you don't need. The layouts stay.</li>
        <li>Add slides with <strong>Slide → Apply layout</strong>, which lists the Virge Dark and Virge Light layouts.</li>
      </ol>

      <h3>Add it to an existing deck</h3>
      <p>Open <strong>Slide → Change theme → Import theme</strong>, upload the file and pick Virge Dark or Virge Light. Repeat for the other one.</p>

      <div class="sg-previews">
        <figure><img src="/styleguide/slides/preview-dark.jpg" alt="All Virge Dark slide layouts" loading="lazy" /><figcaption>Virge Dark</figcaption></figure>
        <figure><img src="/styleguide/slides/preview-light.jpg" alt="All Virge Light slide layouts" loading="lazy" /><figcaption>Virge Light</figcaption></figure>
      </div>
    </section>

    <section>
      <h2>Colours</h2>
      {palettes.map(p => (
        <>
          <h3>{p.name}</h3>
          <p class="sg-note">{p.note}</p>
          <ul class="sg-swatches">
            {p.colors.map(([name, hex]) => (
              <li><span class="sg-swatch" style={`background:${hex}`}></span><strong>{name}</strong><code>{hex}</code></li>
            ))}
          </ul>
        </>
      ))}
      <p class="sg-note">Webinars use the blue accent for Workflow Orchestrator and the pink accent for ShopVirge.</p>
    </section>

    <section>
      <h2>Logos</h2>
      <ul class="sg-logos">
        {logos.map(l => (
          <li>
            <a href={`/styleguide/logo/${l.file}`} download class={`sg-logo sg-logo--${l.tone}`}><img src={`/styleguide/logo/${l.file}`} alt={l.label} loading="lazy" /></a>
            <span>{l.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Type</h2>
      <p>The website uses each device's system font. Slides need one font everywhere, so the theme uses <strong>Inter</strong>, a Google Font that comes close. Code uses <strong>JetBrains Mono</strong>. Both are available in Google Slides without installing anything.</p>
    </section>
  </div>
</Layout>

<style>
  .page-header p { color: var(--text-muted); }
  .sg section { padding: 2.5rem 0; }
  .sg h3 { margin: 2rem 0 0.75rem; font-size: 1.2rem; }
  .sg p { margin-bottom: 1rem; }
  .sg ol { padding-left: 1.4rem; }
  .sg li { margin-bottom: 0.35rem; }
  .sg-note { color: var(--text-muted); font-size: 0.95rem; }
  .sg-previews { display: grid; gap: 2rem; margin-top: 2.5rem; }
  .sg-previews img { display: block; width: 100%; height: auto; border-radius: var(--radius); }
  .sg-previews figcaption { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem; }
  .sg-swatches, .sg-logos { list-style: none; display: grid; gap: 1rem; }
  .sg-swatches { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .sg-swatches li { margin: 0; display: flex; flex-direction: column; font-size: 0.9rem; min-width: 0; }
  .sg-swatches code { color: var(--text-muted); }
  .sg-swatch { height: 64px; border-radius: 8px; margin-bottom: 0.5rem; border: 1px solid rgba(255,255,255,0.15); }
  .sg-logos { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .sg-logos li { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; }
  .sg-logo { display: grid; place-items: center; height: 180px; border-radius: var(--radius); padding: 1.5rem; }
  .sg-logo img { max-width: 100%; max-height: 100%; }
  .sg-logo--dark { background: var(--bg-card); }
  .sg-logo--light { background: #fff; }
</style>
