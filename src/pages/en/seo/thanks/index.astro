---
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import SeoPlansModal from '../../../../components/SeoPlansModal.astro';
import { t } from '../../../../i18n';

const lang = 'en';
const s = t(lang).seo;
---
<Layout title={s.thanks.metaTitle} lang={lang} noindex>
  <section class="seo-thanks">
    <div class="container">
      <!-- Static site: both variants are rendered, the ?type= query picks one in the browser. -->
      <div class="seo-thanks-card" data-variant="free">
        <span class="seo-thanks-icon"><Icon name="mail-check" size={30} /></span>
        <h1><Fragment set:html={s.thanks.freeTitle} /></h1>
        <p>{s.thanks.freeDesc}</p>
        <div class="seo-thanks-upsell">
          <h2>{s.thanks.upsellTitle}</h2>
          <p>{s.thanks.upsellDesc}</p>
          <button type="button" class="btn" data-open-plans>{s.choosePlan}</button>
        </div>
      </div>

      <div class="seo-thanks-card" data-variant="subscribed" hidden>
        <span class="seo-thanks-icon"><Icon name="party-popper" size={30} /></span>
        <h1><Fragment set:html={s.thanks.subscribedTitle} /></h1>
        <p>{s.thanks.subscribedDesc}</p>
      </div>

      <p class="seo-thanks-back"><a href={`/${lang}/seo/`}>← {s.thanks.back}</a></p>
    </div>
  </section>
  <SeoPlansModal lang={lang} />
</Layout>

<script>
  const type = new URLSearchParams(location.search).get('type');
  if (type === 'subscribed') {
    document.querySelectorAll<HTMLElement>('[data-variant]').forEach((el) => (el.hidden = el.dataset.variant !== 'subscribed'));
  }
</script>

<style>
  .seo-thanks { padding: 4rem 0 5rem; }
  .seo-thanks-card {
    max-width: 640px; margin: 0 auto; padding: 2.5rem 2rem; text-align: center;
    border-radius: 20px; background: var(--bg-card);
    box-shadow: inset 0 0 0 1px rgba(168,85,247,0.3), 0 0 50px rgba(108,92,231,0.18);
  }
  @media (max-width: 560px) { .seo-thanks-card { padding: 2rem 1rem; } }
  .seo-thanks-icon {
    display: inline-grid; place-items: center; width: 64px; height: 64px; margin-bottom: 1rem;
    border-radius: 50%; background: rgba(52,211,153,0.15); color: #6ee7b7;
  }
  .seo-thanks-card h1 { font-size: 2rem; margin-bottom: 0.75rem; }
  .seo-thanks-card h1 :global(span) { background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .seo-thanks-card > p { color: var(--text-muted); }
  .seo-thanks-upsell {
    margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid rgba(108,92,231,0.2);
  }
  .seo-thanks-upsell h2 { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .seo-thanks-upsell p { color: var(--text-muted); margin-bottom: 1.25rem; }
  .seo-thanks-back { text-align: center; margin-top: 1.5rem; font-size: 0.9rem; }
</style>
