---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'en';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
        <a href={`/${lang}/services/`} class="btn-ghost">Our services →</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="container">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Built for scale,<br/>designed for real-world use.</h2>
      </div>

      <div class="service-grid">

        <a href={`/${lang}/ai/`} class="scard reveal-card" style="--ghost: 'AI'">
          <div class="scard-top"><span class="scard-num">01</span><span class="scard-arrow">→</span></div>
          <h3>{i.home.aiTitle}</h3>
          <p>{i.home.aiDesc}</p>
        </a>
        <a href={`/${lang}/ecommerce/`} class="scard reveal-card" style="--ghost: 'EC'">
          <div class="scard-top"><span class="scard-num">02</span><span class="scard-arrow">→</span></div>
          <h3>{i.home.ecomTitle}</h3>
          <p>{i.home.ecomDesc}</p>
        </a>
        <a href={`/${lang}/openclaw/`} class="scard reveal-card" style="--ghost: 'OC'">
          <div class="scard-top"><span class="scard-num">03</span><span class="scard-arrow">→</span></div>
          <h3>{i.home.openclawTitle}</h3>
          <p>{i.home.openclawDesc}</p>
        </a>

        <!-- SDN last so cases card overflow always falls into section padding -->
        <div class="scard-wrap reveal-card">
          <a href={`/${lang}/sdn/`} class="scard" style="--ghost: 'SDN'">
            <div class="scard-top"><span class="scard-num">04</span><span class="scard-arrow">→</span></div>
            <h3>{i.home.sdnTitle}</h3>
            <p>{i.home.sdnDesc}</p>
          </a>
          <a href={`/${lang}/blog/librechat-as-agent-orchestrator/`} class="cases-card">
            <span class="cases-eyebrow">Case Study</span>
            <h4>Setting up the WFO agent with LibreChat: no Kubernetes required</h4>
            <div class="cases-meta">
              <span>Jul 2026</span>
              <span class="cases-dot">·</span>
              <span>SDN · LibreChat</span>
            </div>
            <span class="cases-cta">Read case →</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));

  // Spotlight: track cursor per card
  document.querySelectorAll('.scard').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services section ---- */
  .services-section { padding: 6rem 0 5rem; }
  .section-intro { margin-bottom: 3.5rem; }
  .section-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  /* ---- Grid ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-bottom: 7rem; /* room for cases card overflow */
  }

  /* ---- SDN wrapper ---- */
  .scard-wrap {
    position: relative;
    overflow: visible;
  }
  .scard-wrap .scard {
    height: 100%;
  }

  /* Cases card — 50% hangs below the SDN card */
  .cases-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    position: absolute;
    bottom: -5rem;
    right: 1.5rem;
    width: 230px;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.35);
    border-radius: var(--radius);
    padding: 1.25rem;
    z-index: 10;
    box-shadow: 0 8px 28px rgba(0,0,0,0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .cases-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(108,92,231,0.18);
    border-color: rgba(108,92,231,0.55);
    text-decoration: none;
  }
  .cases-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
  }
  .cases-card h4 {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
    flex: 1;
  }
  .cases-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: auto;
  }
  .cases-dot { opacity: 0.4; }
  .cases-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent2);
    margin-top: 0.25rem;
  }

  /* ---- Service cards ---- */
  .scard {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.12);
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* Spotlight layer */
  .scard::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, -999px) var(--my, -999px),
      rgba(108,92,231,0.13),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    border-radius: inherit;
  }
  .scard:hover {
    border-color: rgba(108,92,231,0.35);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    text-decoration: none;
  }
  .scard:hover::before {
    opacity: 1;
  }
  /* Ghost watermark — anchored left so cases card (right) doesn't cover it */
  .scard::after {
    content: var(--ghost, '');
    position: absolute;
    left: 1.5rem;
    bottom: 0.75rem;
    font-size: 6.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: rgba(108,92,231,0.07);
    pointer-events: none;
    user-select: none;
  }
  .scard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .scard-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent2);
    opacity: 0.7;
  }
  .scard-arrow {
    font-size: 1rem;
    color: var(--accent2);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .scard:hover .scard-arrow,
  .scard-featured:hover .scard-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .scard h3, .scard-featured h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text);
  }
  .scard p, .scard-featured p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Scroll reveal ---- */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .reveal.is-visible { opacity: 1; transform: none; }

  .reveal-card {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s ease, transform 0.55s ease,
                box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .reveal-card.is-visible { opacity: 1; transform: none; }
  .reveal-card:nth-child(1) { transition-delay: 0s; }
  .reveal-card:nth-child(2) { transition-delay: 0.08s; }
  .reveal-card:nth-child(3) { transition-delay: 0.16s; }
  .reveal-card:nth-child(4) { transition-delay: 0.24s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .service-grid {
      grid-template-columns: 1fr;
      padding-bottom: 8rem;
    }
    .cases-card {
      width: calc(100% - 3rem);
      right: 1.5rem;
    }
  }
</style>
