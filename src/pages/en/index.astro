---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'en';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="services-inner">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Built for scale,<br/>designed for real-world use.</h2>
      </div>

      <div class="service-grid">

        <!-- 1: AI cluster — card + points + case study -->
        <div class="svc-cluster svc-ai">
          <div class="cluster-cc-border"></div>
          <div class="svc-row">
            <a href={`/${lang}/ai/`} class="scard reveal-card" style="--ghost: 'AI'; --delay: 0s">
              <div class="scard-heading">
                <span class="scard-num">01</span>
                <h3>{i.home.aiTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.aiDesc}</p>
            </a>
          </div>
          <span class="latest-cases-label">Our latest cases:</span>
          <a href={`/${lang}/blog/librechat-as-agent-orchestrator/`} class="cases-card reveal-card" style="--delay: 0.14s">
            <div class="cc-img">
              <img src="/images/librechat-agent-orchestrator.png" alt="" loading="lazy">
            </div>
            <span class="cases-eyebrow">01 · AI</span>
            <h4>Setting up the WFO agent with LibreChat: no Kubernetes required</h4>
            <div class="cases-meta">
              <span>Jul 2026</span>
              <span class="cases-dot">·</span>
              <span>AI · LibreChat</span>
            </div>
            <span class="cases-cta">Read case →</span>
          </a>
        </div>

        <!-- 2: OpenClaw cluster — card + case -->
        <div class="svc-cluster svc-oc">
          <div class="cluster-cc-border"></div>
          <div class="svc-row">
            <a href={`/${lang}/openclaw/`} class="scard reveal-card" style="--ghost: 'OC'; --delay: 0.08s">
              <div class="scard-heading">
                <span class="scard-num">02</span>
                <h3>{i.home.openclawTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.openclawDesc}</p>
            </a>
          </div>
          <a href={`/${lang}/openclaw/`} class="cases-card reveal-card" style="--delay: 0.22s">
            <div class="cc-img">
              <img src="/images/anythingllm-workspace.png" alt="" loading="lazy">
            </div>
            <span class="cases-eyebrow">02 · OC</span>
            <h4>Secure self-hosted AI workspace for a legal firm in four days</h4>
            <div class="cases-meta">
              <span>Apr 2026</span>
              <span class="cases-dot">·</span>
              <span>OpenClaw · Self-hosted</span>
            </div>
            <span class="cases-cta">Read case →</span>
          </a>
        </div>

        <!-- 3: SDN cluster — card + case -->
        <div class="svc-cluster svc-sdn">
          <div class="cluster-cc-border"></div>
          <div class="svc-row">
            <a href={`/${lang}/sdn/`} class="scard reveal-card" style="--ghost: 'SDN'; --delay: 0.16s">
              <div class="scard-heading">
                <span class="scard-num">03</span>
                <h3>{i.home.sdnTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.sdnDesc}</p>
            </a>
          </div>
          <a href={`/${lang}/sdn/`} class="cases-card reveal-card" style="--delay: 0.30s">
            <div class="cc-img">
              <img src="/images/agentic-ai-enterprise.png" alt="" loading="lazy">
            </div>
            <span class="cases-eyebrow">03 · SDN</span>
            <h4>Zero-touch network provisioning across 12 sites for a logistics group</h4>
            <div class="cases-meta">
              <span>May 2026</span>
              <span class="cases-dot">·</span>
              <span>SDN · Automation</span>
            </div>
            <span class="cases-cta">Read case →</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- eCommerce banner -->
  <section class="ec-banner reveal">
    <!-- Table: 5 columns × 3 rows (last col + last row are cosmetic) -->
    <div class="ec-table">
      <!-- Row 1: number | title | empty | empty | cosmetic -->
      <div class="ec-cell ec-cell-num"><span class="ec-num">04</span></div>
      <div class="ec-cell ec-cell-title"><h3>{i.home.ecomTitle}</h3></div>
      <div class="ec-cell ec-cell-empty"></div>
      <div class="ec-cell ec-cell-empty"></div>
      <div class="ec-cell ec-cell-cosmetic-col"></div>

      <!-- Row 2: blank | subtitle | bullets col 1 | bullets col 2 | cosmetic -->
      <div class="ec-cell ec-cell-blank"></div>
      <div class="ec-cell ec-cell-sub"><p>{i.home.ecomDesc}</p></div>
      <div class="ec-cell ec-cell-bullets">
        <ul class="svc-points-list">
          <li>Content as a Service</li>
          <li>ShopVirge webshop</li>
        </ul>
      </div>
      <div class="ec-cell ec-cell-bullets">
        <ul class="svc-points-list">
          <li>ERP &amp; CRM integrations</li>
          <li>AI product descriptions</li>
        </ul>
      </div>
      <div class="ec-cell ec-cell-cosmetic-col"></div>

      <!-- Row 3: cosmetic (1 char tall) -->
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
    </div>

    <div class="ec-banner-bottom">
      <div class="ec-cases-header">
        <span class="svc-points-lead">Case studies</span>
        <div class="ec-cases-actions">
          <a href={`/${lang}/ecommerce/`} class="btn-ghost ec-explore-btn">Explore eCommerce →</a>
          <div class="ec-cases-btns">
            <button class="ec-btn ec-btn-prev" aria-label="Previous">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="13,4 7,10 13,16"/></svg>
            </button>
            <button class="ec-btn ec-btn-next" aria-label="Next">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7,4 13,10 7,16"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="ec-cases">
        <a href={`/${lang}/ecommerce/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>Scaling product content with AI across a 50k-SKU catalogue</h4>
          <div class="cases-meta"><span>Jun 2026</span><span class="cases-dot">·</span><span>eCommerce · AI</span></div>
          <span class="cases-cta">Read case →</span>
        </a>
        <a href={`/${lang}/ecommerce/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>ShopVirge: from brief to live store in under two weeks</h4>
          <div class="cases-meta"><span>May 2026</span><span class="cases-dot">·</span><span>eCommerce · ShopVirge</span></div>
          <span class="cases-cta">Read case →</span>
        </a>
        <a href={`/${lang}/ecommerce/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>Zero-downtime ERP ↔ storefront integration for a B2B retailer</h4>
          <div class="cases-meta"><span>Apr 2026</span><span class="cases-dot">·</span><span>eCommerce · Integrations</span></div>
          <span class="cases-cta">Read case →</span>
        </a>
        <a href={`/${lang}/ecommerce/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>Automating reorder logic with AI agents for a fashion brand</h4>
          <div class="cases-meta"><span>Mar 2026</span><span class="cases-dot">·</span><span>eCommerce · Automation</span></div>
          <span class="cases-cta">Read case →</span>
        </a>
        <a href={`/${lang}/ecommerce/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>Multilingual storefront rollout across 6 markets in 3 months</h4>
          <div class="cases-meta"><span>Feb 2026</span><span class="cases-dot">·</span><span>eCommerce · ShopVirge</span></div>
          <span class="cases-cta">Read case →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));

  // Shared gradient across scard + cases-card (shapes.html technique)
  function applyClusterGradient(cluster) {
    if (!cluster) return;
    const scard = cluster.querySelector('.scard');
    const cc = cluster.querySelector('.cases-card');
    const ccBorder = cluster.querySelector('.cluster-cc-border');
    if (!scard || !cc) return;

    const cr = cluster.getBoundingClientRect();
    const sr = scard.getBoundingClientRect();
    const ccr = cc.getBoundingClientRect();

    const s = { l: sr.left - cr.left, t: sr.top - cr.top, r: sr.right - cr.left, b: sr.bottom - cr.top };
    const c = { l: ccr.left - cr.left, t: ccr.top - cr.top, r: ccr.right - cr.left, b: ccr.bottom - cr.top };

    const sceneX = Math.min(s.l, c.l);
    const sceneY = Math.min(s.t, c.t);
    const sceneW = Math.max(s.r, c.r) - sceneX;
    const sceneH = Math.max(s.b, c.b) - sceneY;

    const grad = 'linear-gradient(200deg, #4833b8 0%, #4833b8 62%, #2593e5 100%)';
    const bsz  = `${sceneW}px ${sceneH}px`;

    scard.style.background          = grad;
    scard.style.backgroundSize      = bsz;
    scard.style.backgroundPosition  = `${-(s.l - sceneX)}px ${-(s.t - sceneY)}px`;

    // cases-card uses its own muted CSS background

    if (ccBorder) {
      ccBorder.style.left   = `${c.l}px`;
      ccBorder.style.top    = `${c.t}px`;
      ccBorder.style.width  = `${ccr.width}px`;
      ccBorder.style.height = `${ccr.height}px`;
    }
  }

  function applyAllGradients() {
    document.querySelectorAll('.svc-cluster').forEach(applyClusterGradient);
  }
  applyAllGradients();
  window.addEventListener('resize', applyAllGradients);

  // Re-measure after each cluster's cases-card reveal animation finishes
  document.querySelectorAll('.svc-cluster .cases-card').forEach(cc => {
    cc.addEventListener('transitionend', applyAllGradients, { once: true });
  });

  // Cases carousel prev/next buttons
  const ecCases = document.querySelector('.ec-cases');
  const ecPrev  = document.querySelector('.ec-btn-prev');
  const ecNext  = document.querySelector('.ec-btn-next');
  if (ecCases && ecPrev && ecNext) {
    const scroll = (dir) => {
      const card = ecCases.querySelector('.ec-case');
      const step = card ? card.offsetWidth + 14 : 300;
      ecCases.scrollBy({ left: dir * step, behavior: 'smooth' });
    };
    ecPrev.addEventListener('click', () => scroll(-1));
    ecNext.addEventListener('click', () => scroll(1));
  }

  // Spotlight: track cursor per card
  document.querySelectorAll('.scard, .ec-case, .cases-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Section spotlight: CSS variable tracking for hero and banner
  document.querySelectorAll('.hero-wrap, .ec-banner').forEach(section => {
    section.addEventListener('mousemove', (e) => {
      const r = section.getBoundingClientRect();
      section.style.setProperty('--mx', `${e.clientX - r.left}px`);
      section.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 68vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(280px circle at var(--mx, -999px) var(--my, -999px), rgba(108,92,231,0.13), transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
    z-index: 1;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services section ---- */
  .services-section { padding: 6rem 0 5rem; overflow: visible; }
  .services-inner {
    padding: 0 3% 0 8%;
  }
  .section-intro { margin-bottom: 3.5rem; margin-left: -5%; }
  .section-label {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  /* ---- Service grid — single row, 3 equal columns ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 3rem;
    align-items: start;
    padding-bottom: 4rem;
  }

  .svc-ai  { position: relative; z-index: 3; }
  .svc-sdn { position: relative; z-index: 2; }

  /* ---- Service clusters (shared: AI, OC, SDN) ---- */
  .svc-cluster {
    display: flex;
    flex-direction: column;
    overflow: visible;
  }
  .svc-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }
  .svc-row .scard {
    flex: none;
    min-height: 200px;
  }

  .svc-points {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0.25rem;
  }
  .svc-points-lead {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .svc-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .svc-points-list li {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    line-height: 1.4;
  }
  .svc-points-list li::before {
    content: '·';
    color: var(--accent2);
    font-size: 1rem;
    margin-top: 0;
    flex-shrink: 0;
  }

  /* ---- eCommerce banner ---- */
  .ec-banner {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(108,92,231,0.15);
    border-bottom: 1px solid rgba(108,92,231,0.15);
    background: rgba(108,92,231,0.04);
    overflow: hidden;
    position: relative;
  }
  .ec-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(280px circle at var(--mx, -999px) var(--my, -999px), rgba(108,92,231,0.13), transparent 65%),
      radial-gradient(rgba(108,92,231,0.12) 1px, transparent 1px);
    background-size: auto, 32px 32px;
    pointer-events: none;
  }
  .ec-banner::after {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: var(--accent);
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.06;
    top: -150px;
    right: 10%;
    pointer-events: none;
  }

  /* ---- Table layout ---- */
  .ec-table {
    display: grid;
    grid-template-columns: 3.5rem 1.5fr 1fr 1fr 3.5rem;
    grid-template-rows: auto auto auto;
    position: relative;
    z-index: 1;
    width: 85%;
    margin: 0 auto;
  }
  .ec-cell {
    border-right: 1px solid rgba(108,92,231,0.12);
    border-bottom: 1px solid rgba(108,92,231,0.12);
    padding: 1.25rem 1.75rem;
  }
  .ec-cell:nth-child(5n) { border-right: none; }
  .ec-cell-num {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0.75rem;
  }
  .ec-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent2);
    opacity: 0.7;
  }
  .ec-cell-title {
    display: flex;
    align-items: center;
  }
  .ec-cell-title h3 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .ec-cell-empty { min-height: 3.5rem; }
  .ec-cell-blank { }
  .ec-cell-sub {
    padding-top: 1rem;
    padding-bottom: 1.75rem;
  }
  .ec-cell-sub p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }
  .ec-cell-bullets {
    padding-top: 1rem;
    padding-bottom: 1.75rem;
    display: flex;
    align-items: flex-start;
  }
  .ec-cell-cosmetic-col { }
  .ec-cell-cosmetic-row {
    border-bottom: none;
    padding: 0;
    height: 1.4em;
  }

  .ec-banner-bottom {
    padding: 1rem 7.5%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .ec-cases-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ec-cases-header .svc-points-lead { margin-bottom: 0; }
  .ec-cases-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ec-explore-btn {
    font-size: 0.85rem;
    padding: 0.5rem 1.25rem;
  }
  .ec-cases-btns { display: flex; gap: 0.5rem; }
  .ec-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--accent2);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .ec-btn:hover { background: rgba(108,92,231,0.12); }
  .ec-btn:disabled { opacity: 0.3; cursor: default; }
  .ec-cases {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ec-cases::-webkit-scrollbar { display: none; }
  .ec-case {
    flex: 0 0 calc(33.333% - 0.6rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
