---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'en';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="services-inner">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Built for scale,<br/>designed for real-world use.</h2>
      </div>

      <div class="service-list">
        <div class="trace-rail" aria-hidden="true"></div>

        <!-- 01: AI -->
        <div class="svc-item reveal">
          <div class="trace-anchor">
            <div class="trace-dot"></div>
          </div>
          <div class="svc-pair">
<a href={`/${lang}/ai/`} class="scard reveal-card" style="--ghost: 'AI'; --delay: 0s">
              <div class="scard-heading">
                <span class="scard-num">01</span>
                <h3>{i.home.aiTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.aiDesc}</p>
              <ul class="scard-bullets">
                <li>Vector databases &amp; RAG</li>
                <li>AI-native integrations</li>
                <li>Production-ready systems</li>
              </ul>
            </a>
            <a href={`/${lang}/blog/librechat-as-agent-orchestrator/`} class="cases-card reveal-card" style="--delay: 0.1s">
              <div class="cc-img">
                <img src="/images/librechat-agent-orchestrator.png" alt="" loading="lazy">
                <span class="cc-badge">Case Study</span>
              </div>
              <h4>Setting up the WFO agent with LibreChat: no Kubernetes required</h4>
              <div class="cases-meta">
                <span>Jul 2026</span><span class="cases-dot">·</span><span>AI · LibreChat</span>
              </div>
              <span class="cases-cta">Read case →</span>
            </a>
          </div>
        </div>

        <!-- 02: OpenClaw -->
        <div class="svc-item reveal">
          <div class="trace-anchor">
            <div class="trace-dot"></div>
          </div>
          <div class="svc-pair">
<a href={`/${lang}/openclaw/`} class="scard reveal-card" style="--ghost: 'OC'; --delay: 0s">
              <div class="scard-heading">
                <span class="scard-num">02</span>
                <h3>{i.home.openclawTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.openclawDesc}</p>
              <ul class="scard-bullets">
                <li>Self-hosted AI</li>
                <li>Managed hosting</li>
                <li>Business automation</li>
              </ul>
            </a>
            <a href={`/${lang}/blog/anythingllm-self-hosted-ai-workspace/`} class="cases-card reveal-card" style="--delay: 0.1s">
              <div class="cc-img">
                <img src="/images/anythingllm-workspace.png" alt="" loading="lazy">
                <span class="cc-badge">Blog Post</span>
              </div>
              <h4>AnythingLLM: the all-in-one AI workspace that replaces your entire stack</h4>
              <div class="cases-meta">
                <span>Mar 2026</span><span class="cases-dot">·</span><span>Self-hosted · AI</span>
              </div>
              <span class="cases-cta">Read post →</span>
            </a>
          </div>
        </div>

        <!-- 03: SDN -->
        <div class="svc-item reveal">
          <div class="trace-anchor">
            <div class="trace-dot"></div>
          </div>
          <div class="svc-pair">
<a href={`/${lang}/sdn/`} class="scard reveal-card" style="--ghost: 'SDN'; --delay: 0s">
              <div class="scard-heading">
                <span class="scard-num">03</span>
                <h3>{i.home.sdnTitle}</h3>
                <span class="scard-arrow">→</span>
              </div>
              <p>{i.home.sdnDesc}</p>
              <ul class="scard-bullets">
                <li>Network automation</li>
                <li>WFO platform</li>
                <li>Infra as code</li>
              </ul>
            </a>
            <a href={`/${lang}/cases/surf-orchestrator-core/`} class="cases-card reveal-card" style="--delay: 0.1s">
              <div class="cc-img">
                <img src="/images/hybrid-search.png" alt="" loading="lazy">
                <span class="cc-badge">Case Study</span>
              </div>
              <h4>How we built hybrid search for SURF's Orchestrator-Core</h4>
              <div class="cases-meta">
                <span>Feb 2026</span><span class="cases-dot">·</span><span>SDN · WFO</span>
              </div>
              <span class="cases-cta">Read case →</span>
            </a>
          </div>
        </div>

        <!-- 04: eCommerce — terminal node only, card is the ec-banner below -->
        <div class="svc-item svc-item--terminal svc-item--end">
          <div class="trace-anchor trace-anchor--terminal">
            <div class="trace-dot"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- eCommerce banner -->
  <section class="ec-banner reveal">
    <div class="ec-table">
      <div class="ec-cell ec-cell-num"><span class="ec-num">04</span></div>
      <div class="ec-cell ec-cell-title">
        <h3>{i.home.ecomTitle} - ShopVirge</h3>
      </div>
      <div class="ec-cell ec-cell-empty"></div>
      <div class="ec-cell ec-cell-empty"></div>
      <div class="ec-cell ec-cell-cosmetic-col"></div>
      <div class="ec-cell ec-cell-blank"></div>
      <div class="ec-cell ec-cell-sub"><p>{i.home.ecomDesc}</p></div>
      <div class="ec-cell ec-cell-bullets">
        <ul class="svc-points-list">
          <li>Content as a Service</li>
          <li>ShopVirge webshop</li>
        </ul>
      </div>
      <div class="ec-cell ec-cell-bullets">
        <ul class="svc-points-list">
          <li>ERP &amp; CRM integrations</li>
          <li>AI product descriptions</li>
        </ul>
      </div>
      <div class="ec-cell ec-cell-cosmetic-col"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
      <div class="ec-cell ec-cell-cosmetic-row"></div>
    </div>
    <div class="ec-banner-bottom">
      <div class="ec-cases-header">
        <span class="ec-cases-lead">Case studies</span>
        <div class="ec-cases-actions">
          <a href={`/${lang}/ecommerce/`} class="btn-ghost ec-explore-btn">Our eCommerce services →</a>
          <a href="https://shopvirge.com/en/" target="_blank" rel="noopener" class="sv-launch-btn">Launch your store ↗</a>
          <div class="ec-cases-btns">
            <button class="ec-btn ec-btn-prev" aria-label="Previous">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="13,4 7,10 13,16"/></svg>
            </button>
            <button class="ec-btn ec-btn-next" aria-label="Next">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7,4 13,10 7,16"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="ec-cases">
        <!-- 1: JVJ case study -->
        <a href={`/${lang}/cases/jvj-selection/`} class="ec-case">
          <span class="cases-eyebrow">Case Study</span>
          <h4>A referral-gated webshop for Jas voor Jeugd, free clothing for youth in Limburg</h4>
          <div class="cases-meta"><span>2026</span><span class="cases-dot">·</span><span>ShopVirge · Charity</span></div>
          <span class="cases-cta">Read case →</span>
        </a>

        <!-- 2: JVJ live store -->
        <a href="https://shop.jvjselection.nl/" target="_blank" rel="noopener" class="ec-case ec-case--store">
          <span class="ec-ext-label">
            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 1h6v6M9 1L1 9"/></svg>
            Live Store · ShopVirge
          </span>
          <h4>JVJ Selection by Jas voor Jeugd</h4>
          <div class="cases-meta"><span>Limburg, NL</span><span class="cases-dot">·</span><span>Free clothing redistribution for youth</span></div>
          <span class="cases-cta">Visit store ↗</span>
        </a>

        <!-- 3: Blog post 1 -->
        <a href="https://shopvirge.com/en/blog/shopify-alternatives-europe-2026/" target="_blank" rel="noopener" class="ec-case ec-case--sv">
          <span class="ec-ext-label">
            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 1h6v6M9 1L1 9"/></svg>
            ShopVirge Blog
          </span>
          <h4>Shopify Alternatives for European Entrepreneurs in 2026</h4>
          <div class="cases-meta"><span>2026</span><span class="cases-dot">·</span><span>Platform · Europe</span></div>
          <span class="cases-cta">Read post ↗</span>
        </a>

        <!-- 4: CO2 Tree live store -->
        <a href="https://shop.co2-tree.eu/" target="_blank" rel="noopener" class="ec-case ec-case--store">
          <span class="ec-ext-label">
            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 1h6v6M9 1L1 9"/></svg>
            Live Store · ShopVirge
          </span>
          <h4>CO2 Tree</h4>
          <div class="cases-meta"><span>Europe</span><span class="cases-dot">·</span><span>Sustainable products &amp; CO2 offsetting</span></div>
          <span class="cases-cta">Visit store ↗</span>
        </a>

        <!-- 5: Blog post 2 -->
        <a href="https://shopvirge.com/en/blog/multilingual-webshop-5-mistakes/" target="_blank" rel="noopener" class="ec-case ec-case--sv">
          <span class="ec-ext-label">
            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 1h6v6M9 1L1 9"/></svg>
            ShopVirge Blog
          </span>
          <h4>5 Mistakes Entrepreneurs Make with Multilingual Webshops</h4>
          <div class="cases-meta"><span>2026</span><span class="cases-dot">·</span><span>Multilingual · Europe</span></div>
          <span class="cases-cta">Read post ↗</span>
        </a>

        <!-- 6: Blog post 3 -->
        <a href="https://shopvirge.com/en/blog/ai-product-descriptions-webshop-2026/" target="_blank" rel="noopener" class="ec-case ec-case--sv">
          <span class="ec-ext-label">
            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 1h6v6M9 1L1 9"/></svg>
            ShopVirge Blog
          </span>
          <h4>AI Product Descriptions: The Practical Playbook for Your Webshop in 2026</h4>
          <div class="cases-meta"><span>2026</span><span class="cases-dot">·</span><span>AI · Copywriting</span></div>
          <span class="cases-cta">Read post ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  // Extend trace-rail through the ec-banner
  function extendTraceRail() {
    const rail = document.querySelector('.trace-rail');
    const serviceList = document.querySelector('.service-list');
    const ecBanner = document.querySelector('.ec-banner');
    if (!rail || !serviceList || !ecBanner) return;
    const listBottom = serviceList.getBoundingClientRect().bottom;
    const title = ecBanner.querySelector('.ec-cell-title h3');
    const target = title ? title.getBoundingClientRect().top : ecBanner.getBoundingClientRect().bottom;
    const extension = target - listBottom;
    rail.style.bottom = (extension > 0 ? -extension : 0) + 'px';
  }
  window.addEventListener('load', extendTraceRail);
  window.addEventListener('resize', extendTraceRail);
  extendTraceRail();

  function syncServiceCardGradient() {
    const cards = [...document.querySelectorAll('.service-list .svc-item:not(.svc-item--end) .scard')];
    if (!cards.length) return;

    const first = cards[0].getBoundingClientRect();
    const last = cards[cards.length - 1].getBoundingClientRect();
    const span = Math.max(last.bottom - first.top, first.height);

    cards.forEach(card => {
      const cardRect = card.getBoundingClientRect();
      card.style.setProperty('--service-card-gradient-height', `${span}px`);
      card.style.setProperty('--service-card-gradient-y', `${cardRect.top - first.top}px`);
    });
  }
  window.addEventListener('load', syncServiceCardGradient);
  window.addEventListener('resize', syncServiceCardGradient);
  if (document.fonts) document.fonts.ready.then(syncServiceCardGradient);
  syncServiceCardGradient();

  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));

  // Draw trace rail when service list scrolls into view
  const traceRail = document.querySelector('.trace-rail');
  if (traceRail) {
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) traceRail.classList.add('is-drawn'); },
      { threshold: 0.05 }
    ).observe(traceRail.parentElement);
  }

  // Trace glow — fixed viewport position, appears when line scrolls behind it
  (() => {
    const rail = document.querySelector('.trace-rail');
    if (!rail) return;

    // Inject styles globally — Astro scopes component <style>, so the
    // dynamically-created element won't get the scoped attribute otherwise.
    const styleEl = document.createElement('style');
    styleEl.textContent = `
      .trace-glow {
        position: fixed;
        top: 42vh;
        transform: translate(-50%, -50%);
        width: 0;
        height: 50px;
        pointer-events: none;
        z-index: 50;
        box-shadow: 0 0 6px 3px rgba(37,147,229,0.18),
                    0 0 18px 8px rgba(37,147,229,0.09),
                    0 0 40px 16px rgba(37,147,229,0.04);
        opacity: 0;
      }
    `;
    document.head.appendChild(styleEl);

    const glow = document.createElement('div');
    glow.className = 'trace-glow';
    document.body.appendChild(glow);

    const TARGET = 0.42;
    let visible = false;

    function update() {
      const r = rail.getBoundingClientRect();
      glow.style.left = `${r.left + 0.5}px`;

      const target = window.innerHeight * TARGET;
      const onLine = r.top <= target && r.bottom >= target;
      if (onLine !== visible) {
        visible = onLine;
        // Slow fade-in (0.9s + 0.2s delay), fast fade-out (0.12s)
        glow.style.transition = onLine
          ? 'opacity 0.9s ease 0.2s'
          : 'opacity 0.12s ease';
        glow.style.opacity = onLine ? '1' : '0';
      }
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  })();

  // Spotlight: track cursor per card
  document.querySelectorAll('.scard, .cases-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Cases carousel prev/next
  const ecCases = document.querySelector('.ec-cases');
  const ecPrev  = document.querySelector('.ec-btn-prev');
  const ecNext  = document.querySelector('.ec-btn-next');
  if (ecCases && ecPrev && ecNext) {
    const scroll = (dir) => {
      const card = ecCases.querySelector('.ec-case');
      const step = card ? card.offsetWidth + 14 : 300;
      ecCases.scrollBy({ left: dir * step, behavior: 'smooth' });
    };
    ecPrev.addEventListener('click', () => scroll(-1));
    ecNext.addEventListener('click', () => scroll(1));
  }

  // Spotlight for ec-case cards
  document.querySelectorAll('.ec-case').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Section spotlight for hero and ec-banner
  document.querySelectorAll('.hero-wrap, .ec-banner').forEach(section => {
    section.addEventListener('mousemove', (e) => {
      const r = section.getBoundingClientRect();
      section.style.setProperty('--mx', `${e.clientX - r.left}px`);
      section.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 68vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(280px circle at var(--mx, -999px) var(--my, -999px), rgba(108,92,231,0.13), transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
    z-index: 1;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services section ---- */
  .services-section { padding: 6rem 0 0; overflow: visible; }
  .services-inner { padding: 0 5% 0 8%; max-width: 2000px; margin: 0 auto; }
  .section-intro { margin-bottom: 3rem; }
  .section-label {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  /* ---- Vertical service list with trace ---- */
  .service-list {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 3rem;
    --service-card-gradient: linear-gradient(
      180deg,
      #4833b8 0%,
      #5d46d8 34%,
      #376dd9 68%,
      #2593e5 100%
    );
  }

  /* Vertical trace rail */
  .trace-rail {
    position: absolute;
    left: 1rem;
    top: -2.5rem; /* extends up toward section-intro */
    bottom: 0;
    width: 1px;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--accent) 6%,
      var(--accent2) 100%
    );
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .trace-rail.is-drawn { transform: scaleY(1); }

  /* Each row */
  .svc-item {
    position: relative;
    --trace-anchor-top: calc(2.5rem + 1.5rem + 1.68rem);
    padding: 2.5rem 0;
  }
  .svc-item + .svc-item {
    border-top: 1px solid rgba(108,92,231,0.08);
  }

  /* Node anchored on the trace rail */
  .trace-anchor {
    position: absolute;
    left: -3rem;
    top: calc(var(--trace-anchor-top) - 4px);
    width: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }
  .trace-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 0 3px rgba(37,147,229,0.15), 0 0 8px rgba(37,147,229,0.35);
    flex-shrink: 0;
  }

  /* Horizontal branch from each dot to its card pair */
  .svc-item:not(.svc-item--end) .trace-anchor::after {
    content: '';
    position: absolute;
    left: calc(50% + 4px);
    top: 3px;
    width: calc(2rem - 4px);
    height: 1px;
