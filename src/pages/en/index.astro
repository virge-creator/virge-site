---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../i18n';

const lang = 'en';
const i = t(lang);
---
<Layout title="Home" lang={lang}>

  <!-- Hero -->
  <div class="hero-wrap">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <span class="hero-eyebrow">AI · SDN · eCommerce</span>
      <h1><Fragment set:html={i.hero.title} /></h1>
      <p>{i.hero.description}</p>
      <div class="hero-actions">
        <a href={`/${lang}/contact/`} class="btn">{i.hero.cta}</a>
        <a href={`/${lang}/services/`} class="btn-ghost">Our services →</a>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="services-section">
    <div class="container">
      <div class="section-intro reveal">
        <span class="section-label">{i.home.whatWeDo}</span>
        <h2>Built for scale,<br/>designed for real-world use.</h2>
      </div>
      <div class="service-grid">
        <a href={`/${lang}/ai/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">01</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.aiTitle}</h3>
          <p>{i.home.aiDesc}</p>
        </a>
        <a href={`/${lang}/sdn/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">02</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.sdnTitle}</h3>
          <p>{i.home.sdnDesc}</p>
        </a>
        <a href={`/${lang}/ecommerce/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">03</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.ecomTitle}</h3>
          <p>{i.home.ecomDesc}</p>
        </a>
        <a href={`/${lang}/openclaw/`} class="scard reveal-card">
          <div class="scard-top">
            <span class="scard-num">04</span>
            <span class="scard-arrow">→</span>
          </div>
          <h3>{i.home.openclawTitle}</h3>
          <p>{i.home.openclawDesc}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container reveal">
    <CTA lang={lang} />
  </div>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));
</script>

<style>
  /* ---- Hero ---- */
  .hero-wrap {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    animation: drift 10s ease-in-out infinite;
  }
  .orb-1 {
    width: 520px; height: 520px;
    background: var(--accent);
    top: -140px; left: -120px;
  }
  .orb-2 {
    width: 380px; height: 380px;
    background: var(--accent2);
    bottom: -80px; right: 5%;
    animation-delay: -5s;
    animation-duration: 13s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -40px) scale(1.04); }
    66%       { transform: translate(-20px, 20px) scale(0.97); }
  }
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(108,92,231,0.18) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.05s both;
  }
  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.15s both;
  }
  :global(.hero-inner h1 span) {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-inner p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 560px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.28s both;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.42s both;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    border: 1px solid rgba(108,92,231,0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: rgba(108,92,231,0.6);
    text-decoration: none;
  }

  /* ---- Services ---- */
  .services-section {
    padding: 6rem 0 5rem;
  }
  .section-intro {
    margin-bottom: 3.5rem;
  }
  .section-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.85rem;
  }
  .section-intro h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .scard {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid rgba(108,92,231,0.15);
    border-radius: var(--radius);
    padding: 2rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .scard:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 48px rgba(108,92,231,0.18);
    border-color: rgba(108,92,231,0.45);
    text-decoration: none;
  }
  .scard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .scard-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent2);
    opacity: 0.7;
  }
  .scard-arrow {
    font-size: 1rem;
    color: var(--accent2);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .scard:hover .scard-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .scard h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text);
  }
  .scard p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Scroll reveal ---- */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .reveal.is-visible { opacity: 1; transform: none; }

  .reveal-card {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s ease, transform 0.55s ease,
                box-shadow 0.25s ease, border-color 0.25s ease; /* keep hover transitions too */
  }
  .reveal-card.is-visible { opacity: 1; transform: none; }
  .reveal-card:nth-child(1) { transition-delay: 0s; }
  .reveal-card:nth-child(2) { transition-delay: 0.08s; }
  .reveal-card:nth-child(3) { transition-delay: 0.16s; }
  .reveal-card:nth-child(4) { transition-delay: 0.24s; }

  /* Ensure hover still works after reveal */
  .reveal-card.is-visible:hover {
    transform: translateY(-5px);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
