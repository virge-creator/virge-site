---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { t } from '../../i18n';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/structured-data';

const lang = 'en';
const i = t(lang);

const jsonLd = [
  serviceSchema({ name: 'eCommerce', description: i.ecommerce.metaDesc, path: `/${lang}/ecommerce/` }),
  breadcrumbSchema([
    { name: i.nav.home, path: `/${lang}/` },
    { name: i.nav.services, path: `/${lang}/services/` },
    { name: i.nav.ecommerce, path: `/${lang}/ecommerce/` },
  ]),
  faqSchema(i.ecommerce.faq),
];
---
<Layout title={i.ecommerce.metaTitle} description={i.ecommerce.metaDesc} lang={lang} jsonLd={jsonLd}>
  <div class="page-back">
    <a href={`/${lang}/services/`} class="back-link">{i.nav.backToServices}</a>
  </div>
  <div class="page-header">
    <h1><Fragment set:html={i.ecommerce.title} /></h1>
    <p>{i.ecommerce.description}</p>
  </div>

  <section>
    <div class="container">
      <div class="features">
        <div class="feature highlight">
          <h3>{i.ecommerce.contentTitle}</h3>
          <p>{i.ecommerce.contentDesc}</p>
          <a href={`/${lang}/ecommerce/content/`} class="feature-link">{i.ecommerce.contentLink}</a>
        </div>
        <div class="feature">
          <h3>{i.ecommerce.shopTitle}</h3>
          <p>{i.ecommerce.shopDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.ecommerce.consultancyTitle}</h3>
          <p>{i.ecommerce.consultancyDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.ecommerce.integrationsTitle}</h3>
          <p>{i.ecommerce.integrationsDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={i.ecommerce.faq} lang={lang} />
  <div class="container"><CTA lang={lang} /></div>
</Layout>
