---
import Layout from '../../../layouts/Layout.astro';
import CTA from '../../../components/CTA.astro';
import { t } from '../../../i18n';
import { getActiveJobs } from '../../../data/jobs';

const lang = 'en';
const i = t(lang);
const jobs = getActiveJobs();
---
<Layout title="Jobs" description={i.jobs.metaDesc} lang={lang}>
  <div class="page-header">
    <h1><Fragment set:html={i.jobs.title} /></h1>
    <p>{i.jobs.description}</p>
  </div>

  <section>
    <div class="container">
      <h2 class="section-title">{i.jobs.openPositions}</h2>
      {jobs.length === 0 ? (
        <p class="no-jobs">{i.jobs.noJobs}</p>
      ) : (
        <div class="job-list">
          {jobs.map(job => (
            <a href={`/${lang}/jobs/${job.slug}/`} class="job-card">
              <div class="job-card-content">
                <h3>{job.title[lang]}</h3>
                <p class="job-summary">{job.summary[lang]}</p>
                <div class="job-meta">
                  <span class="job-meta-item">📍 {job.location}</span>
                  <span class="job-meta-item">💼 {job.type[lang]}</span>
                </div>
                <div class="job-tags">
                  {job.tags.map(tag => (
                    <span class="job-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <span class="job-arrow">→</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="container"><CTA lang={lang} /></div>
</Layout>

<style>
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--accent2);
  }
  .no-jobs {
    color: var(--text-muted);
    font-size: 1.1rem;
    padding: 2rem 0;
  }
  .job-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }
  .job-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .job-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.15);
  }
  .job-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .job-summary {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    max-width: 600px;
  }
  .job-meta {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .job-meta-item {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .job-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .job-tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(139, 92, 246, 0.15);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 6px;
  }
  .job-arrow {
    font-size: 1.5rem;
    color: var(--accent);
    flex-shrink: 0;
    margin-left: 1.5rem;
  }
  @media (max-width: 640px) {
    .job-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem;
    }
    .job-arrow {
      margin-left: 0;
      margin-top: 0.75rem;
    }
  }
</style>
