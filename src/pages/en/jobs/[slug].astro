---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { t } from '../../../i18n';
import { getActiveJobs, getJobBySlug } from '../../../data/jobs';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return getActiveJobs().map(job => ({
    params: { slug: job.slug },
  }));
};

const lang = 'en';
const i = t(lang);
const { slug } = Astro.params;
const job = getJobBySlug(slug as string)!;
---
<Layout title={job.title[lang]} description={job.summary[lang]} lang={lang}>
  <div class="page-header">
    <h1>{job.title[lang]}</h1>
    <p>{job.summary[lang]}</p>
  </div>

  <section>
    <div class="container">
      <a href={`/${lang}/jobs/`} class="back-link">{i.jobs.backToJobs}</a>

      <div class="job-detail">
        <div class="job-detail-meta">
          <span><Icon name="map-pin" size={15} class="meta-icon" /> {job.location}</span>
          <span><Icon name="briefcase" size={15} class="meta-icon" /> {job.type[lang]}</span>
        </div>

        <div class="job-tags">
          {job.tags.map(tag => (
            <span class="job-tag">{tag}</span>
          ))}
        </div>

        <div class="job-section">
          <h2><Icon name="file-text" size={20} class="section-icon" /> {i.jobs.aboutRole}</h2>
          <p>{job.about[lang]}</p>
        </div>

        <div class="job-section">
          <h2><Icon name="check-circle" size={20} class="section-icon" /> {i.jobs.requirements}</h2>
          <ul>
            {job.requirements[lang].map(req => <li>{req}</li>)}
          </ul>
        </div>

        <div class="job-section">
          <h2><Icon name="star" size={20} class="section-icon" /> {i.jobs.niceToHave}</h2>
          <ul>
            {job.niceToHave[lang].map(item => <li>{item}</li>)}
          </ul>
        </div>

        <div class="job-section">
          <h2><Icon name="gift" size={20} class="section-icon" /> {i.jobs.whatWeOffer}</h2>
          <ul>
            {job.offer[lang].map(item => <li>{item}</li>)}
          </ul>
        </div>

        <div class="apply-box">
          <h2><Icon name="send" size={20} class="section-icon" /> {i.jobs.applyTitle}</h2>
          <p>{i.jobs.applyDesc} <a href="mailto:jobs@virge.io" class="apply-email">jobs@virge.io</a></p>
          <a href={`mailto:jobs@virge.io?subject=Application: ${job.title[lang]}`} class="apply-btn">
            {i.jobs.applyNow} <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: inline-block;
    color: var(--link);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
  }
  .back-link:hover { opacity: 0.8; }
  .job-detail { max-width: 720px; }
  .job-detail-meta {
    display: flex;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .job-detail-meta span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .job-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }
  .job-tag {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    background: rgba(139, 92, 246, 0.22);
    color: var(--link);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
  }
  .job-section { margin-bottom: 2.5rem; }
  .job-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--link);
    margin-bottom: 0.75rem;
  }
  .job-section p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .job-section ul { list-style: none; padding: 0; }
  .job-section li {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: 0.35rem 0;
    padding-left: 1.5rem;
    position: relative;
  }
  .job-section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }
  .apply-box {
    background: var(--surface);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 12px;
    padding: 2rem;
    margin-top: 3rem;
  }
  .apply-box h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .apply-box p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }
  .apply-email {
    color: var(--link);
    font-weight: 600;
    text-decoration: none;
  }
  .apply-email:hover { text-decoration: underline; }
  .apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .apply-btn:hover { opacity: 0.9; }
</style>
