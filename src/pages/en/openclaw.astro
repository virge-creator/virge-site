---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { t } from '../../i18n';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/structured-data';

const lang = 'en';
const i = t(lang);

const jsonLd = [
  serviceSchema({ name: 'OpenClaw Consultancy', description: i.openclaw.metaDesc, path: `/${lang}/openclaw/` }),
  breadcrumbSchema([
    { name: i.nav.home, path: `/${lang}/` },
    { name: i.nav.services, path: `/${lang}/services/` },
    { name: i.nav.openclaw, path: `/${lang}/openclaw/` },
  ]),
  faqSchema(i.openclaw.faq),
];
---
<Layout title={i.openclaw.metaTitle} description={i.openclaw.metaDesc} lang={lang} jsonLd={jsonLd}>
  <div class="page-back">
    <a href={`/${lang}/services/`} class="back-link">{i.nav.backToServices}</a>
  </div>
  <div class="page-header">
    <h1><Fragment set:html={i.openclaw.title} /></h1>
    <p>{i.openclaw.description}</p>
  </div>

  <section>
    <div class="container">
      <div class="features">
        <div class="feature">
          <h3>{i.openclaw.deployTitle}</h3>
          <p>{i.openclaw.deployDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.openclaw.hostingTitle}</h3>
          <p>{i.openclaw.hostingDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.openclaw.securityTitle}</h3>
          <p>{i.openclaw.securityDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.openclaw.automationTitle}</h3>
          <p>{i.openclaw.automationDesc}</p>
        </div>
      </div>

      <div class="highlight" style="margin-top:3rem;padding:2rem;border-radius:12px;background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.2);">
        <h3 style="margin-top:0;">{i.openclaw.whatIsTitle}</h3>
        <p style="margin-bottom:0;">{i.openclaw.whatIsDesc}</p>
      </div>
    </div>
  </section>

  <FAQ items={i.openclaw.faq} lang={lang} />
  <div class="container"><CTA lang={lang} /></div>
</Layout>
