---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { t } from '../../i18n';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/structured-data';

const lang = 'en';
const i = t(lang);

const jsonLd = [
  serviceSchema({ name: 'Software Defined Networking', description: i.sdn.metaDesc, path: `/${lang}/sdn/` }),
  breadcrumbSchema([
    { name: i.nav.home, path: `/${lang}/` },
    { name: i.nav.services, path: `/${lang}/services/` },
    { name: i.nav.sdn, path: `/${lang}/sdn/` },
  ]),
  faqSchema(i.sdn.faq),
];
---
<Layout title={i.sdn.metaTitle} description={i.sdn.metaDesc} lang={lang} jsonLd={jsonLd}>
  <div class="page-back">
    <a href={`/${lang}/services/`} class="back-link">{i.nav.backToServices}</a>
  </div>
  <div class="page-header">
    <h1><Fragment set:html={i.sdn.title} /></h1>
    <p>{i.sdn.description}</p>
  </div>

  <section>
    <div class="container">
      <div class="features">
        <div class="feature">
          <h3>{i.sdn.wfoTitle}</h3>
          <p><Fragment set:html={i.sdn.wfoDesc} /></p>
        </div>
        <div class="feature">
          <h3>{i.sdn.enterpriseTitle}</h3>
          <p>{i.sdn.enterpriseDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.sdn.modelingTitle}</h3>
          <p>{i.sdn.modelingDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.sdn.integrationsTitle}</h3>
          <p>{i.sdn.integrationsDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.sdn.iacTitle}</h3>
          <p>{i.sdn.iacDesc}</p>
        </div>
        <div class="feature">
          <h3>{i.sdn.trainingTitle}</h3>
          <p>{i.sdn.trainingDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={i.sdn.faq} lang={lang} />
  <div class="container"><CTA lang={lang} /></div>
</Layout>
