---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import { FORMSPREE_WEBINAR } from '../data/webinars';

interface Props { lang: Lang; id?: string }

const { lang, id = 'contact-panel' } = Astro.props;
const i = t(lang);
const en = lang === 'en';
const title = en ? 'Discuss an integration' : 'Bespreek een integratie';
const rule = en ? 'Tell us which services and network APIs you want to connect.' : 'Vertel welke services en netwerk-API’s je wilt koppelen.';
// Same Formspree form as the contact page; the hidden fields tell us where the message came from.
const ACTION = 'https://formspree.io/f/mpqjjpnb';
---
<aside class="contact-panel" aria-labelledby={`${id}-title`}>
  <div class="cp-head">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{rule}</p>
  </div>

  <form method="POST" action={ACTION}>
    <input type="hidden" name="_subject" value="Integration enquiry (WFO demo page)" />
    <input type="hidden" name="form" value="demo-contact" />
    <input type="hidden" name="language" value={lang} />
    <input type="hidden" name="page" value={Astro.url.pathname} />

    <div class="cp-fields">
      <label class="cp-sr" for={`${id}-name`}>{i.contact.nameLabel}</label>
      <input type="text" id={`${id}-name`} name="name" required placeholder={i.contact.namePlaceholder} autocomplete="name" />
      <label class="cp-sr" for={`${id}-email`}>{i.contact.emailLabel}</label>
      <input type="email" id={`${id}-email`} name="email" required placeholder={i.contact.emailPlaceholder} autocomplete="email" />
    </div>
    <label class="cp-sr" for={`${id}-message`}>{i.contact.messageLabel}</label>
    <textarea id={`${id}-message`} name="message" required placeholder={i.contact.messagePlaceholder}></textarea>
    <button type="submit" class="btn cp-submit">{i.contact.submit}</button>
    <p class="form-privacy" set:html={i.privacy.contactNotice} />
  </form>
</aside>

<style>
  /* Same fields and button treatment as the home page webinar panel (HeroWebinars), without its glow. */
  .contact-panel {
    position: relative;
    width: 100%;
    text-align: left;
    padding: 1.5rem;
    border-radius: 18px;
    background: rgb(18,18,42);
    border: 1px solid rgba(108,92,231,0.28);
  }
  .cp-head { margin-bottom: 1rem; padding-right: 2rem; }
  .cp-head h2 { font-size: 1.2rem; margin: 0 0 0.15rem; color: #fff; }
  .cp-head p { color: var(--text-muted); font-size: 0.85rem; margin: 0; }
  .cp-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cp-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-bottom: 0.6rem; }
  input, textarea {
    width: 100%; padding: 0.7rem 0.9rem; border-radius: 8px; font-size: 0.95rem; font-family: inherit;
    background: var(--bg); border: 1px solid rgba(108,92,231,0.25); color: var(--text);
  }
  textarea { min-height: 110px; resize: vertical; margin-bottom: 0.75rem; display: block; }
  input:focus, textarea:focus { outline: none; border-color: var(--accent); }
  .cp-submit { width: 100%; }
  .contact-panel .form-privacy { font-size: 0.75rem; margin-top: 0.6rem; }
  @media (max-width: 420px) {
    .contact-panel { padding: 1.1rem; }
    .cp-fields { grid-template-columns: 1fr; }
  }
</style>
