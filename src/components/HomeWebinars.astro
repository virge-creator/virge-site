---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import WebinarCard from './WebinarCard.astro';
import WebinarForm from './WebinarForm.astro';
import { getUpcoming } from '../data/webinars';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
const SHOWN = 2;
// Render a couple of spares so the browser script can drop past webinars and still show two.
const upcoming = getUpcoming(new Date(), SHOWN + 2);
---
{upcoming.length > 0 && (
  <section class="home-webinars">
    <div class="container">
      <div class="home-webinars-intro">
        <span class="home-webinars-label">{i.webinars.homeLabel}</span>
        <h2>{i.webinars.homeTitle}</h2>
        <p>{i.webinars.homeDesc}</p>
      </div>
      <div class="home-webinars-grid">
        <div class="home-webinars-cards" data-home-webinars data-shown={SHOWN}>
          {upcoming.map((w, idx) => (
            <div class="home-webinar-slot" hidden={idx >= SHOWN}>
              <WebinarCard lang={lang} webinar={w} registerHref="#home-register" />
            </div>
          ))}
          <a href={`/${lang}/webinars/`} class="home-webinars-all">{i.webinars.allWebinars}</a>
        </div>
        <div class="home-webinars-form" id="home-register">
          <h3>{i.webinars.formTitle}</h3>
          <p>{i.webinars.formDesc}</p>
          <WebinarForm lang={lang} limit={SHOWN} compact />
        </div>
      </div>
    </div>
  </section>
)}

<script>
  // Keep the next two webinars that have not ended yet (static builds can lag behind).
  document.querySelectorAll<HTMLElement>('[data-home-webinars]').forEach((wrap) => {
    const shown = Number(wrap.dataset.shown) || 2;
    let n = 0;
    wrap.querySelectorAll<HTMLElement>('.home-webinar-slot').forEach((slot) => {
      const card = slot.querySelector<HTMLElement>('[data-webinar-card]');
      const ended = new Date(card?.dataset.end || '').getTime() <= Date.now();
      slot.hidden = ended || ++n > shown;
    });
  });
</script>

<style>
  .home-webinars { padding: 6rem 0 1rem; }
  .home-webinars-intro { margin-bottom: 2.5rem; max-width: 720px; }
  .home-webinars-label {
    display: inline-block; font-size: 1.5rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--link); margin-bottom: 0.85rem;
  }
  .home-webinars-intro h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; line-height: 1.2; color: #fff; margin-bottom: 0.75rem; }
  .home-webinars-intro p { color: var(--text-muted); font-size: 1.08rem; }
  .home-webinars-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 2rem; align-items: start; }
  .home-webinars-cards { display: flex; flex-direction: column; gap: 1.25rem; }
  .home-webinar-slot[hidden] { display: none; }
  .home-webinars-all { font-weight: 600; align-self: flex-start; }
  .home-webinars-form {
    scroll-margin-top: 6rem; padding: 1.75rem; border-radius: var(--radius);
    background: rgba(18,18,42,0.75); border: 1px solid rgba(108,92,231,0.25);
  }
  .home-webinars-form h3 { font-size: 1.35rem; margin-bottom: 0.3rem; }
  .home-webinars-form p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem; }
  @media (max-width: 960px) {
    .home-webinars-grid { grid-template-columns: 1fr; }
  }
</style>
