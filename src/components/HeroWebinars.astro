---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import type { WebinarProduct } from '../data/webinars';
import { getUpcoming, endIso, formatWebinarDate, FORMSPREE_WEBINAR } from '../data/webinars';

interface Props {
  lang: Lang;
  /** Only show webinars about this product. */
  product?: WebinarProduct;
  title?: string;
}

const { lang, product } = Astro.props;
const i = t(lang);
const SHOWN = 2;
// Render a couple of spares so the browser script can drop past webinars and still show two.
const upcoming = getUpcoming().filter(w => !product || w.product === product).slice(0, SHOWN + 2);
const title = Astro.props.title ?? i.webinars.upcoming;
// Dutch weekday names are lowercase; capitalise since it starts the line.
const weekday = (date: string) => {
  const name = formatWebinarDate(date, lang, { weekday: 'long' });
  return name.charAt(0).toUpperCase() + name.slice(1);
};
---
{upcoming.length > 0 && (
  <aside class="hero-webinars" aria-labelledby="hero-webinars-title" data-hero-webinars data-shown={SHOWN}>
    <div class="hw-head">
      <h2 id="hero-webinars-title"><span class="hw-pulse" aria-hidden="true"></span>{title}</h2>
      <p>{i.webinars.heroRule}</p>
    </div>

    <form method="POST" action={FORMSPREE_WEBINAR}>
      <input type="hidden" name="_subject" value="Webinar registration" />
      <input type="hidden" name="form" value="webinar" />
      <input type="hidden" name="language" value={lang} />

      <fieldset class="hw-options">
        <legend class="hw-sr">{i.webinars.webinarLabel}</legend>
        {upcoming.map((w, idx) => (
          <label class:list={['hw-option', `is-${w.product}`]} data-end={endIso(w.date)} hidden={idx >= SHOWN}>
            <input type="radio" name="webinar" value={`${w.date} · ${w.title.en}`} required checked={idx === 0} />
            <span class="hw-date" aria-hidden="true">
              <span class="hw-day">{formatWebinarDate(w.date, lang, { day: 'numeric' })}</span>
              <span class="hw-month">{formatWebinarDate(w.date, lang, { month: 'short' }).replace('.', '')}</span>
            </span>
            <span class="hw-text">
              <span class="hw-product">{w.product === 'wfo' ? 'Workflow Orchestrator' : 'ShopVirge'}</span>
              <span class="hw-title">{w.title[lang]}</span>
              <span class="hw-time">{weekday(w.date)} · {i.webinars.timeLabel}</span>
            </span>
            <span class="hw-check" aria-hidden="true"></span>
          </label>
        ))}
      </fieldset>

      <div class="hw-fields">
        <label class="hw-sr" for="hw-name">{i.webinars.nameLabel}</label>
        <input type="text" id="hw-name" name="name" required placeholder={i.webinars.namePlaceholder} autocomplete="name" />
        <label class="hw-sr" for="hw-email">{i.webinars.emailLabel}</label>
        <input type="email" id="hw-email" name="email" required placeholder={i.webinars.emailPlaceholder} autocomplete="email" />
      </div>
      <button type="submit" class="btn hw-submit">{i.webinars.submit}</button>
      <p class="form-privacy" set:html={i.privacy.formNotice} />
    </form>

    <a href={`/${lang}/webinars/`} class="hw-all">{i.webinars.allWebinars}</a>
  </aside>
)}

<script>
  // Keep the next two webinars that have not ended yet (static builds can lag behind).
  document.querySelectorAll<HTMLElement>('[data-hero-webinars]').forEach((panel) => {
    const shown = Number(panel.dataset.shown) || 2;
    const now = Date.now();
    let n = 0;
    panel.querySelectorAll<HTMLElement>('.hw-option').forEach((opt) => {
      if (new Date(opt.dataset.end || '').getTime() <= now) opt.remove();
      else opt.hidden = ++n > shown;
    });
    const visible = Array.from(panel.querySelectorAll<HTMLInputElement>('.hw-option:not([hidden]) input'));
    if (!visible.length) {
      panel.remove();
      return;
    }
    if (!visible.some((input) => input.checked)) visible[0].checked = true;
  });
</script>

<style>
  .hero-webinars {
    --wfo: #5cb8ff;
    --shopvirge: #e879f9;
    position: relative;
    width: 100%;
    text-align: left;
    padding: 1.5rem;
    border-radius: 18px;
    background:
      radial-gradient(120% 70% at 100% 0%, rgba(168,85,247,0.16), transparent 60%),
      rgba(18,18,42,0.78);
    border: 1px solid rgba(108,92,231,0.28);
    box-shadow: 0 30px 80px -40px rgba(108,92,231,0.7);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: hwFadeUp 0.7s ease 0.5s both;
  }
  @keyframes hwFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .hw-head { margin-bottom: 1rem; }
  .hw-head h2 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.2rem; margin: 0 0 0.15rem; color: #fff; }
  .hw-head p { color: var(--text-muted); font-size: 0.85rem; margin: 0; }
  .hw-pulse { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 0 rgba(74,222,128,0.6); animation: hwPulse 2s infinite; flex-shrink: 0; }
  @keyframes hwPulse {
    70% { box-shadow: 0 0 0 9px rgba(74,222,128,0); }
    100% { box-shadow: 0 0 0 0 rgba(74,222,128,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hw-pulse { animation: none; }
  }

  .hw-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .hw-options { border: 0; display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.9rem; }
  .hw-option {
    --c: var(--wfo);
    position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.9rem;
    padding: 0.8rem 0.9rem; border-radius: 12px; cursor: pointer;
    background: rgba(10,10,26,0.55); border: 1px solid rgba(108,92,231,0.18);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .hw-option[hidden] { display: none; }
  .hw-option.is-shopvirge { --c: var(--shopvirge); }
  .hw-option:hover { border-color: color-mix(in srgb, var(--c) 45%, transparent); }
  .hw-option:has(input:checked) {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 9%, rgba(10,10,26,0.6));
    box-shadow: 0 0 24px -10px var(--c);
  }
  .hw-option:has(input:focus-visible) { outline: 2px solid #fff; outline-offset: 2px; }
  .hw-option input { position: absolute; opacity: 0; pointer-events: none; }

  .hw-date {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 3.2rem; height: 3.4rem; border-radius: 10px; line-height: 1.05;
    background: linear-gradient(150deg, color-mix(in srgb, var(--c) 80%, transparent), color-mix(in srgb, var(--c) 35%, var(--accent)));
  }
  .hw-day { font-size: 1.35rem; font-weight: 800; color: #fff; }
  .hw-month { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.9); }
  .hw-text { display: flex; flex-direction: column; min-width: 0; }
  .hw-product { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--c); }
  .hw-title { font-size: 0.93rem; font-weight: 650; color: #fff; line-height: 1.3; margin: 0.1rem 0; }
  .hw-time { font-size: 0.78rem; color: var(--text-muted); }
  .hw-check {
    width: 1.15rem; height: 1.15rem; border-radius: 50%; flex-shrink: 0;
    border: 1.5px solid rgba(196,165,255,0.45); transition: border-color 0.2s, background 0.2s;
  }
  .hw-option:has(input:checked) .hw-check {
    border-color: var(--c);
    background: radial-gradient(circle, var(--c) 45%, transparent 50%);
  }

  .hw-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-bottom: 0.75rem; }
  .hw-fields input {
    width: 100%; padding: 0.7rem 0.9rem; border-radius: 8px; font-size: 0.95rem; font-family: inherit;
    background: var(--bg); border: 1px solid rgba(108,92,231,0.25); color: var(--text);
  }
  .hw-fields input:focus { outline: none; border-color: var(--accent); }
  .hw-submit { width: 100%; }
  .hero-webinars .form-privacy { font-size: 0.75rem; margin-top: 0.6rem; }

  .hw-all { display: inline-block; margin-top: 0.9rem; font-size: 0.9rem; font-weight: 600; }

  @media (max-width: 420px) {
    .hero-webinars { padding: 1.1rem; }
    .hw-fields { grid-template-columns: 1fr; }
  }
</style>
