---
import Icon from './Icon.astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const serviceLogos: Record<string, string> = {
  chat: '/images/cases/wfo-demos/librechat.svg',
  wfo: '/images/cases/surf-orchestrator-core/wfo-logo.png',
  netbox: '/images/cases/wfo-demos/netbox-mark.svg',
};
const nodes = [
  { id: 'request', label: en ? 'You' : 'Jij', icon: 'user-round', col: 1, row: 1, kind: 'request',
    route: en ? 'Ticket / request' : 'Ticket / vraag',
    text: en ? 'Start with a customer ticket, monitoring alert or change request. The planner combines service records, inventory and device evidence to investigate it.' : 'Begin met een klantmelding, monitoringalarm of wijzigingsverzoek. De planner combineert servicegegevens, inventaris en apparaatmetingen voor het onderzoek.' },
  { id: 'chat', label: 'LibreChat', icon: 'messages-square', col: 1, row: 2, kind: 'request',
    route: 'LibreChat → OpenAI-compatible API → A2A proxy',
    text: en ? 'The chat interface sends the request to an OpenAI-compatible endpoint. The A2A proxy bridges that request to the planner.' : 'De chatinterface stuurt de vraag naar een OpenAI-compatibel endpoint. De A2A-proxy geeft deze door aan de planner.' },
  { id: 'proxy', label: 'A2A proxy', icon: 'arrow-left-right', col: 1, row: 3, kind: 'request',
    route: 'OpenAI-compatible API → A2A → Planner',
    text: en ? 'The proxy connects LibreChat to the agent stack. The incoming chat API and the agent-to-agent protocol are separate interfaces.' : 'De proxy verbindt LibreChat met de agents. De inkomende chat-API en het agent-to-agentprotocol zijn afzonderlijke interfaces.' },
  { id: 'planner', label: 'Planner', icon: 'bot', col: 2, row: 2, kind: 'planner',
    route: 'Planner → A2A → WFO / Inventory / Network',
    text: en ? 'One planner delegates to three specialist agents over A2A, then combines their findings. MCP provides tools to the specialists; A2A connects the agents.' : 'Eén planner verdeelt het onderzoek via A2A over drie gespecialiseerde agents en combineert hun bevindingen. MCP ontsluit hun tools; A2A verbindt de agents.' },
  { id: 'wfo-agent', label: 'WFO agent', icon: 'bot', col: 3, row: 1, kind: 'agent',
    route: 'Planner → A2A → WFO agent → MCP → WFO',
    text: en ? 'Looks up subscriptions, customers and stored service configuration through WFO’s MCP tools. An active subscription or enabled port in WFO does not establish live device health.' : 'Zoekt subscriptions, klanten en opgeslagen serviceconfiguratie op via de MCP-tools van WFO. Een actieve subscription of ingeschakelde poort in WFO bewijst geen gezonde live verbinding.' },
  { id: 'inventory-agent', label: 'Inventory agent', icon: 'bot', col: 3, row: 2, kind: 'agent',
    route: 'Inventory agent → MCP → netbox-mcp → API → NetBox',
    text: en ? 'Resolves inventory context through netbox-mcp. NetBox supplies device and interface records, which are distinct from the live measurements collected by the network agent.' : 'Haalt inventariscontext op via netbox-mcp. NetBox levert apparaat- en poortgegevens, los van de live metingen die de network-agent verzamelt.' },
  { id: 'network-agent', label: 'Network agent', icon: 'bot', col: 3, row: 3, kind: 'agent',
    route: 'Network agent → MCP → network-mcp',
    text: en ? 'Compares WFO service intent with current SR Linux state and path measurements. The demo investigates and recommends follow-up; it does not execute repairs or maintenance changes.' : 'Vergelijkt de WFO-serviceconfiguratie met de actuele SR Linux-status en padmetingen. De demo onderzoekt en adviseert, maar voert geen herstel- of onderhoudswijzigingen uit.' },
  { id: 'netbox-mcp', label: 'netbox-mcp', icon: 'plug', col: 4, row: 2, kind: 'tool',
    route: 'Inventory agent → MCP → netbox-mcp → API → NetBox',
    text: en ? 'The MCP server exposes inventory tools to the inventory agent and queries the NetBox API. It supplies inventory context rather than live network telemetry.' : 'Deze MCP-server ontsluit inventaristools voor de inventory-agent en bevraagt de NetBox-API. Hij levert inventariscontext, geen live netwerktelemetrie.' },
  { id: 'network-mcp', label: 'network-mcp', icon: 'plug', col: 4, row: 3, kind: 'tool',
    route: 'WFO: REST + GraphQL · SR Linux: JSON-RPC',
    text: en ? 'Reads stored service intent from WFO over REST and GraphQL, and queries SR Linux over JSON-RPC. These two evidence sources let the agent detect disagreement between configuration and device state.' : 'Leest opgeslagen serviceconfiguratie uit WFO via REST en GraphQL en bevraagt SR Linux via JSON-RPC. Met deze twee bronnen kan de agent verschillen tussen configuratie en apparaatstatus vaststellen.' },
  { id: 'wfo', label: 'Workflow Orchestrator', icon: 'workflow', col: 5, row: 1, kind: 'system',
    route: en ? 'WFO agent: MCP · network-mcp: REST + GraphQL' : 'WFO-agent: MCP · network-mcp: REST + GraphQL',
    text: en ? 'Stores service intent, subscription status, customer mapping and maintenance flags. The WFO agent uses MCP; network-mcp also reads the service data over REST and GraphQL.' : 'Bewaart serviceconfiguratie, subscriptionstatus, klantkoppelingen en onderhoudsvlaggen. De WFO-agent gebruikt MCP; network-mcp leest de servicegegevens ook via REST en GraphQL.' },
  { id: 'netbox', label: 'NetBox', icon: 'database', col: 5, row: 2, kind: 'system',
    route: 'netbox-mcp → API → NetBox',
    text: en ? 'Provides the network inventory used in the investigation. Device and interface records help identify the affected equipment; live health is checked separately on SR Linux.' : 'Levert de netwerkinventaris voor het onderzoek. Apparaat- en poortgegevens helpen de betrokken apparatuur te vinden; de live status wordt apart op SR Linux gecontroleerd.' },
  { id: 'srlinux', label: 'SR Linux', icon: 'router', col: 5, row: 3, kind: 'system',
    route: 'network-mcp → JSON-RPC → SR Linux',
    text: en ? 'The emulated containerlab path connects Amsterdam, Paris and London with no alternate route. Interface state and packet-loss measurements are device evidence; individual samples can differ.' : 'Het geëmuleerde containerlab-pad verbindt Amsterdam, Parijs en Londen zonder alternatief pad. Poortstatus en pakketverliesmetingen komen van de apparaten; afzonderlijke steekproeven kunnen verschillen.' },
];
const edges = [
  { from: 'request', to: 'chat', label: '' },
  { from: 'chat', to: 'proxy', label: 'API' },
  { from: 'proxy', to: 'planner', label: 'A2A' },
  { from: 'planner', to: 'wfo-agent', label: 'A2A' },
  { from: 'planner', to: 'inventory-agent', label: 'A2A' },
  { from: 'planner', to: 'network-agent', label: 'A2A' },
  { from: 'wfo-agent', to: 'wfo', label: 'MCP' },
  { from: 'inventory-agent', to: 'netbox-mcp', label: 'MCP' },
  { from: 'network-agent', to: 'network-mcp', label: 'MCP' },
  { from: 'netbox-mcp', to: 'netbox', label: 'API' },
  { from: 'network-mcp', to: 'srlinux', label: 'JSON-RPC' },
  { from: 'network-mcp', to: 'wfo', label: 'REST + GraphQL', shared: true },
];
---

<figure class="setup" data-architecture>
  <figcaption>
    <h2>{en ? 'Multi-agent architecture' : 'Multi-agentarchitectuur'}</h2>
    <p class="interaction-hint"><span aria-hidden="true"><Icon name="mouse-pointer-2" size={15} /></span>{en ? 'Hover, focus or tap a node to explore' : 'Beweeg over, focus op of tik op een node voor uitleg'}</p>
  </figcaption>
  <div class="architecture-map" role="group" aria-label={en ? 'Request path, specialist agents, tools and systems' : 'Vraag, gespecialiseerde agents, tools en systemen'}>
    <svg class="connections" aria-hidden="true" fill="none">
      <defs><marker id="architecture-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="m1 1 5 3-5 3" /></marker></defs>
      {edges.map(edge => <g data-from={edge.from} data-to={edge.to} class:list={['edge', { 'edge--shared': edge.shared }]}>
        <path class="edge-path" marker-end="url(#architecture-arrow)" />
        <text class="edge-label" text-anchor="middle">{edge.label}</text>
      </g>)}
    </svg>
    {nodes.map(node => <button type="button" class:list={['map-node', `map-node--${node.kind}`]} data-node={node.id} style={`--desktop-col:${node.col};--desktop-row:${node.row}`} aria-controls={`architecture-detail-${node.id}`} aria-describedby={`architecture-description-${node.id}`} aria-pressed="false" disabled>
      <span class:list={['node-symbol', { 'node-symbol--netbox': node.id === 'netbox', 'node-symbol--wfo': node.id === 'wfo' }]} aria-hidden="true">
        {serviceLogos[node.id]
          ? <img src={serviceLogos[node.id]} data-service-logo={node.id} alt="" width="36" height="36" />
          : <Icon name={node.icon} size={26} />}
      </span>
      <span class="node-label">{node.label}</span>
    </button>)}
  </div>
  <div class="explanations">
    <div class="explanation" data-detail="overview">
      <h3>{en ? 'One planner. Three specialists. Shared evidence.' : 'Eén planner. Drie specialisten. Gedeelde gegevens.'}</h3>
      <p>{en ? 'A2A connects the agents; MCP exposes their tools. Network tools compare WFO intent over REST and GraphQL with SR Linux state over JSON-RPC. Select a node to follow its connections.' : 'A2A verbindt de agents; MCP ontsluit hun tools. Netwerktools vergelijken WFO-configuratie via REST en GraphQL met SR Linux-status via JSON-RPC. Kies een node om de verbindingen te volgen.'}</p>
    </div>
    {nodes.map(node => <div class="explanation" data-detail={node.id} id={`architecture-detail-${node.id}`} hidden>
      <div class="explanation-heading"><h3>{node.label}</h3><span class="connection-route">{node.route}</span></div>
      <p id={`architecture-description-${node.id}`}>{node.text}</p>
    </div>)}
  </div>
  <noscript><dl class="text-architecture">{nodes.map(node => <><dt>{node.label} · {node.route}</dt><dd>{node.text}</dd></>)}</dl></noscript>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-architecture]').forEach(setup => {
    const map = setup.querySelector<HTMLElement>('.architecture-map')!;
    const svg = setup.querySelector<SVGSVGElement>('.connections')!;
    const nodes = [...setup.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const edges = [...svg.querySelectorAll<SVGGElement>('.edge')];
    const panels = [...setup.querySelectorAll<HTMLElement>('[data-detail]')];
    let pinned: string | null = null;
    let hovered: string | null = null;
    let focused: string | null = null;
    let dismissed = false;
    const show = () => {
      const active = dismissed ? null : hovered ?? focused ?? pinned;
      panels.forEach(panel => { panel.hidden = panel.dataset.detail !== (active ?? 'overview'); });
      const related = new Set([active]);
      edges.forEach(edge => {
        const connected = edge.dataset.from === active || edge.dataset.to === active;
        edge.classList.toggle('is-active', connected);
        if (connected) { related.add(edge.dataset.from!); related.add(edge.dataset.to!); }
      });
      nodes.forEach(node => {
        const id = node.dataset.node!;
        node.setAttribute('aria-pressed', String(id === pinned));
        node.classList.toggle('is-active', id === active);
        node.classList.toggle('is-related', related.has(id));
      });
      setup.classList.toggle('is-exploring', !!active);
    };
    nodes.forEach(node => {
      node.disabled = false;
      node.addEventListener('pointerenter', event => {
        if (event.pointerType === 'touch') return;
        hovered = node.dataset.node!; dismissed = false; show();
      });
      node.addEventListener('focus', () => { hovered = null; focused = node.dataset.node!; dismissed = false; show(); });
      node.addEventListener('blur', () => { focused = null; show(); });
      node.addEventListener('click', () => {
        pinned = pinned === node.dataset.node ? null : node.dataset.node!;
        dismissed = false; show();
      });
    });
    // Keep the explanation available while the pointer moves from a node to its text.
    setup.addEventListener('pointerleave', () => { hovered = null; show(); });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !(hovered || focused || pinned)) return;
      pinned = null; dismissed = true; show();
    });
    const draw = () => {
      const bounds = map.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
      const compact = matchMedia('(max-width: 760px)').matches;
      const point = (id: string) => {
        const node = nodes.find(node => node.dataset.node === id)!;
        const circle = node.querySelector('.node-symbol')!.getBoundingClientRect();
        const label = node.querySelector('.node-label')!.getBoundingClientRect();
        return { x: circle.left - bounds.left + circle.width / 2, y: circle.top - bounds.top + circle.height / 2, r: circle.width / 2 + 5, bottom: label.bottom - bounds.top + 8 };
      };
      edges.forEach(edge => {
        const a = point(edge.dataset.from!), b = point(edge.dataset.to!);
        let d: string, tx: number, ty: number;
        if (edge.classList.contains('edge--shared')) {
          const x1 = a.x + a.r, x2 = b.x - b.r, gutter = (x1 + x2) / 2;
          d = compact
            ? `M${a.x},${a.bottom} C${a.x},${b.y - b.r - 20} ${b.x},${b.y - b.r - 20} ${b.x},${b.y - b.r}`
            : `M${x1},${a.y} C${gutter},${a.y} ${gutter},${b.y} ${x2},${b.y}`;
          tx = compact ? (a.x + b.x) / 2 : gutter;
          ty = compact ? b.y - b.r - 24 : (a.y + b.y) / 2 - 12;
        } else if (compact && edge.dataset.from === 'proxy') {
          d = `M${a.x},${a.bottom} C${a.x},${b.y} ${b.x + 60},${b.y} ${b.x + b.r},${b.y}`;
          tx = a.x - 14; ty = (a.y + b.y) / 2;
        } else if (compact && edge.dataset.from === 'planner') {
          const start = a.bottom, end = b.y - b.r, middle = (start + end) / 2;
          d = `M${a.x},${start} C${a.x},${middle} ${b.x},${middle} ${b.x},${end}`;
          tx = b.x; ty = middle - 5;
        } else if (Math.abs(a.x - b.x) < 2) {
          const end = b.y - b.r;
          d = `M${a.x},${a.bottom} V${end}`;
          tx = a.x + (compact ? 0 : 23); ty = (a.bottom + end) / 2 - 3;
        } else {
          const x1 = a.x + a.r, x2 = b.x - b.r, middle = (x1 + x2) / 2;
          d = `M${x1},${a.y} C${middle},${a.y} ${middle},${b.y} ${x2},${b.y}`;
          tx = middle; ty = (a.y + b.y) / 2 - 9;
        }
        edge.querySelector('.edge-path')!.setAttribute('d', d);
        const label = edge.querySelector('text')!;
        label.setAttribute('x', String(tx)); label.setAttribute('y', String(ty));
      });
    };
    new ResizeObserver(draw).observe(map);
    document.fonts.ready.then(draw);
    draw();
  });
</script>

<style>
  .setup { margin: 0; padding: 1.75rem; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); }
  figcaption { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .75rem 2rem; }
  h2 { margin: 0; font-size: 1.45rem; line-height: 1.4; }
  .interaction-hint { display: flex; align-items: center; gap: .5rem; margin: 0; color: var(--text-muted); font-size: .8rem; line-height: 1.6; }
  .interaction-hint > span { display: flex; }
  .architecture-map { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-rows: repeat(3, 132px); position: relative; margin: 1.5rem 0 1rem; }
  .connections { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .edge-path { stroke: var(--link); stroke-width: 1.25; }
  marker path { stroke: var(--link); stroke-width: 1.3; }
  .edge-label { fill: var(--text-muted); font-family: var(--font-body); font-size: 11px; paint-order: stroke; stroke: var(--bg); stroke-width: 6px; stroke-linejoin: round; }
  .edge--shared .edge-path { stroke-dasharray: 4 5; stroke: var(--text-muted); }
  .edge--shared .edge-label { font-size: 10px; opacity: 0; }
  .edge--shared.is-active .edge-label { opacity: 1; }
  .map-node { grid-column: var(--desktop-col); grid-row: var(--desktop-row); display: flex; flex-direction: column; align-items: center; align-self: center; gap: .6rem; position: relative; height: 116px; margin: 0; padding: .5rem .2rem; border: 0; background: transparent; color: var(--text); font: inherit; cursor: pointer; min-width: 0; -webkit-tap-highlight-color: transparent; }
  .map-node:disabled { cursor: default; }
  .node-symbol { display: grid; place-items: center; flex-shrink: 0; width: 52px; height: 52px; border: 1px solid var(--border); border-radius: 50%; background: var(--bg-card); color: var(--link); transition: background .18s ease-out, border-color .18s ease-out; }
  .node-symbol img { display: block; width: 36px; height: 36px; object-fit: contain; }
  .node-symbol--wfo img { width: 42px; height: 42px; border-radius: 6px; }
  .node-symbol--wfo { overflow: hidden; }
  .map-node--request .node-symbol { color: var(--text-muted); }
  .map-node--planner .node-symbol { border-color: var(--link); }
  .node-label { max-width: 17ch; font-size: .8rem; line-height: 1.4; text-align: center; text-wrap: balance; }
  .map-node--tool .node-label { font-family: ui-monospace, monospace; font-size: .75rem; }
  .map-node:focus-visible { outline: none; }
  .map-node:focus-visible .node-symbol { outline: 2px solid var(--link); outline-offset: 5px; }
  .map-node:hover .node-symbol, .map-node.is-active .node-symbol { border-color: var(--link); background: var(--bg-card-hover); }
  .node-symbol--netbox, .map-node:hover .node-symbol--netbox, .map-node.is-active .node-symbol--netbox { background: #fff; }
  .node-symbol--wfo, .map-node:hover .node-symbol--wfo, .map-node.is-active .node-symbol--wfo { background: #04385f; }
  .is-exploring .edge:not(.is-active) { opacity: var(--edge-dim, .3); }
  .is-exploring .edge.is-active .edge-path { stroke: var(--link); stroke-width: 2; }
  .is-related .node-symbol { border-color: var(--link); }
  .is-active .node-label { color: var(--link); }
  .explanations { display: grid; min-height: 140px; border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .explanation { grid-area: 1 / 1; }
  .explanation[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .explanation-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: .35rem 1.5rem; }
  h3 { margin: 0; font-size: .95rem; line-height: 1.5; font-weight: 600; }
  .connection-route { color: var(--link); font-size: .75rem; line-height: 1.6; overflow-wrap: anywhere; }
  .explanation p { max-width: 90ch; color: var(--text-muted); font-size: .85rem; line-height: 1.8; margin: .5rem 0 0; }
  .text-architecture { font-size: .85rem; line-height: 1.8; }
  .text-architecture dt { margin-top: 1rem; font-weight: 600; }
  .text-architecture dd { color: var(--text-muted); }
  @media (max-width: 760px) {
    .setup { padding: 1.25rem; }
    h2 { font-size: 1.3rem; }
    .interaction-hint { font-size: .75rem; }
    .architecture-map { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, 112px); margin-top: .75rem; }
    [data-node="request"] { --col: 1; --row: 1; }
    [data-node="chat"] { --col: 2; --row: 1; }
    [data-node="proxy"] { --col: 3; --row: 1; }
    [data-node="planner"] { --col: 2; --row: 2; }
    [data-node="wfo-agent"] { --col: 1; --row: 3; }
    [data-node="inventory-agent"] { --col: 2; --row: 3; }
    [data-node="network-agent"] { --col: 3; --row: 3; }
    [data-node="netbox-mcp"] { --col: 2; --row: 4; }
    [data-node="network-mcp"] { --col: 3; --row: 4; }
    [data-node="wfo"] { --col: 1; --row: 5; }
    [data-node="netbox"] { --col: 2; --row: 5; }
    [data-node="srlinux"] { --col: 3; --row: 5; }
    .map-node { grid-column: var(--col); grid-row: var(--row); height: 104px; }
    .node-symbol { width: 44px; height: 44px; }
    .node-symbol img { width: 30px; height: 30px; }
    .node-symbol--wfo img { width: 36px; height: 36px; }
    .node-symbol :global(svg) { width: 24px; height: 24px; }
    .node-label { font-size: .75rem; }
    .map-node--tool .node-label { font-size: .6875rem; }
    .edge-label { font-size: 10px; }
    .edge--shared .edge-label { font-size: 9px; }
    .explanation-heading { display: block; }
    .connection-route { display: block; margin-top: .35rem; }
  }
  @media (max-width: 380px) {
    .setup { padding: 1rem .75rem; }
    .node-label { font-size: .6875rem; }
    .edge-label { font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node-symbol { transition: none; }
  }
</style>
