---
import type { Lang } from '../i18n';
import { t, getOtherLang, languages } from '../i18n';
import Icon from './Icon.astro';
import { getAlternateSlug } from '../data/blog-slugs';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const i = t(lang);
const otherLang = getOtherLang(lang);
const base = `/${lang}/`;
const currentPath = Astro.url.pathname;
let switchPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

// Handle jobs/vacatures URL translation
if (lang === 'en') {
  switchPath = switchPath.replace('/nl/jobs/', '/nl/vacatures/');
} else {
  switchPath = switchPath.replace('/en/vacatures/', '/en/jobs/');
}

// Handle blog post slug translation
const blogPrefix = lang === 'nl' ? '/nl/blog/' : '/en/blog/';
const altBlogPrefix = otherLang === 'nl' ? '/nl/blog/' : '/en/blog/';
if (currentPath.startsWith(blogPrefix) && currentPath !== blogPrefix) {
  const slug = currentPath.replace(blogPrefix, '').replace(/\/$/, '');
  if (slug) {
    const altSlug = getAlternateSlug(slug, lang);
    switchPath = `${altBlogPrefix}${altSlug}/`;
  }
}

const jobsPath = lang === 'nl' ? `${base}vacatures/` : `${base}jobs/`;

const langNames: Record<Lang, string> = { en: 'English', nl: 'Nederlands' };
const flagSvg: Record<Lang, string> = {
  en: `<svg viewBox="0 0 24 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="18" fill="#012169"/><path d="M0,0 L24,18 M24,0 L0,18" stroke="#fff" stroke-width="3.6"/><path d="M0,0 L24,18 M24,0 L0,18" stroke="#C8102E" stroke-width="1.6"/><path d="M12,0 V18 M0,9 H24" stroke="#fff" stroke-width="6"/><path d="M12,0 V18 M0,9 H24" stroke="#C8102E" stroke-width="3.4"/></svg>`,
  nl: `<svg viewBox="0 0 24 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="6" fill="#AE1C28"/><rect y="6" width="24" height="6" fill="#fff"/><rect y="12" width="24" height="6" fill="#21468B"/></svg>`,
};

const serviceItems = [
  { href: `${base}sdn/`, label: i.nav.sdn },
  { href: `${base}ai/`, label: i.nav.ai },
  { href: `${base}openclaw/`, label: i.nav.openclaw },
  { href: `${base}ecommerce/`, label: i.nav.ecommerce },
];
---
<nav>
  <div class="container">
    <a href={base} class="logo"><img src="/logo.png" alt="Virge.io" class="logo-img" /></a>
    <button class="menu-toggle" aria-label="Menu" onclick="document.querySelector('.links').classList.toggle('open')">
      <Icon name="menu" size={24} />
    </button>
    <ul class="links">
      <li><a href={base}>{i.nav.home}</a></li>
      <li class="has-dropdown">
        <div class="dropdown-parent">
          <a href={`${base}services/`}>{i.nav.services}</a>
          <button class="chevron-btn" aria-label="Toggle services menu" aria-expanded="false">
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <ul class="dropdown">
          {serviceItems.map(s => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </li>
      <li><a href={`${base}cases/`}>{i.nav.cases}</a></li>
      <li><a href={`${base}blog/`}>{i.nav.blog}</a></li>
      <li><a href={jobsPath}>{i.nav.jobs}</a></li>
      <li><a href={`${base}contact/`}>{i.nav.contact}</a></li>
      <li class="lang-switch">
        <button type="button" class="lang-current" aria-haspopup="true" aria-expanded="false" aria-label={`Language: ${langNames[lang]}`}>
          <span class="flag" set:html={flagSvg[lang]} />
          <span class="lang-code">{lang.toUpperCase()}</span>
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="lang-menu">
          {languages.map(l => (
            <li>
              <a
                href={l === lang ? currentPath : switchPath}
                class:list={['lang-option', { active: l === lang }]}
                aria-current={l === lang ? 'page' : undefined}
              >
                <span class="flag" set:html={flagSvg[l]} />
                <span class="lang-name">{langNames[l]}</span>
                {l === lang && (
                  <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </div>
</nav>

<style>
  .logo-img {
    height: 40px;
    width: auto;
  }
  /* Language switcher */
  .lang-switch {
    margin-left: 0.5rem;
    position: relative;
  }
  .flag {
    display: inline-flex;
    width: 20px;
    height: 15px;
    border-radius: 3px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15);
  }
  .flag :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lang-current {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    background: none;
    border: 1px solid rgba(139,92,246,0.5);
    border-radius: 8px;
    cursor: pointer;
    color: #a78bfa;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .lang-current .lang-code {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .lang-current .chevron {
    opacity: 0.6;
    transition: transform 0.2s;
  }
  .lang-switch:hover .lang-current,
  .lang-switch:focus-within .lang-current {
    background: rgba(139,92,246,0.15);
    border-color: rgba(139,92,246,0.8);
    color: #c4b5fd;
  }
  .lang-switch:hover .chevron,
  .lang-switch:focus-within .chevron,
  .lang-switch.open .chevron {
    transform: rotate(180deg);
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 170px;
    background: linear-gradient(160deg, #16143a 0%, #0d0c24 100%);
    border-radius: var(--radius);
    padding: 0.4rem;
    list-style: none;
    z-index: 200;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.1),
      0 12px 36px rgba(0,0,0,0.55),
      0 0 22px 4px rgba(108,92,231,0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.97);
    transform-origin: top right;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .lang-switch:hover .lang-menu,
  .lang-switch:focus-within .lang-menu,
  .lang-switch.open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .lang-menu li {
    display: block;
    width: 100%;
  }
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.85rem;
    white-space: nowrap;
    color: rgba(255,255,255,0.6);
    font-size: 0.95rem;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    box-sizing: border-box;
  }
  .lang-option:hover {
    color: #fff;
    background: rgba(108,92,231,0.2);
    text-decoration: none;
  }
  .lang-option.active {
    color: #fff;
  }
  .lang-option .check {
    margin-left: auto;
    color: #a78bfa;
  }

  /* Uniform link size */
  :global(nav .links a),
  :global(nav .links button) {
    font-size: 1.05rem;
  }

  /* Dropdown */
  .has-dropdown {
    position: relative;
  }
  .dropdown-parent {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .chevron-btn {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0.15rem 0.2rem;
    cursor: pointer;
    color: inherit;
    border-radius: 4px;
  }
  .chevron {
    transition: transform 0.2s;
    opacity: 0.6;
  }
  .has-dropdown:hover .chevron,
  .has-dropdown.open .chevron {
    transform: rotate(180deg);
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.75rem;
    min-width: 180px;
    background: linear-gradient(160deg, #16143a 0%, #0d0c24 100%);
    border-radius: var(--radius);
    padding: 0.4rem;
    list-style: none;
    z-index: 200;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.1),
      0 12px 36px rgba(0,0,0,0.55),
      0 0 22px 4px rgba(108,92,231,0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.97);
    transform-origin: top left;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    overflow: hidden;
  }
  .dropdown::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      200px circle at var(--mx, -999px) var(--my, -999px),
      rgba(108,92,231,0.18),
      transparent 70%
    );
    pointer-events: none;
    border-radius: inherit;
  }
  .has-dropdown:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .dropdown li {
    display: block;
    width: 100%;
  }
  .dropdown li a {
    display: block;
    width: 100%;
    padding: 0.55rem 1rem;
    white-space: nowrap;
    color: rgba(255,255,255,0.6);
    font-size: 0.95rem;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }
  .dropdown li a:hover {
    color: #fff;
    background: rgba(108,92,231,0.2);
    text-decoration: none;
  }

  /* Mobile: dropdown becomes inline */
  @media (max-width: 768px) {
    .dropdown {
      position: static;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      padding: 0 0 0 0.5rem;
      margin-top: 0.25rem;
      transform: none;
      transition: none;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
    }
    .has-dropdown:hover .dropdown {
      opacity: 0;
      visibility: hidden;
    }
    .has-dropdown.open .dropdown {
      opacity: 1;
      visibility: visible;
      max-height: 200px;
    }

    /* Language switcher: two always-visible pills */
    .lang-switch {
      margin-left: 0;
    }
    .lang-current {
      display: none;
    }
    .lang-menu {
      position: static;
      display: flex;
      gap: 0.5rem;
      min-width: 0;
      padding: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
    }
    .lang-menu li {
      width: auto;
    }
    .lang-option {
      border: 1px solid rgba(139,92,246,0.35);
      padding: 0.4rem 0.75rem;
    }
    .lang-option.active {
      border-color: rgba(139,92,246,0.8);
      background: rgba(139,92,246,0.15);
    }
    .lang-option .check {
      display: none;
    }
  }
</style>

<script>
  // Chevron button toggles mobile dropdown; checked live so resize works
  document.querySelectorAll('.chevron-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!window.matchMedia('(max-width: 768px)').matches) return;
      const item = btn.closest('.has-dropdown');
      const open = item?.classList.toggle('open') ?? false;
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  // Language switcher: click toggles (for touch devices), outside click closes
  const langSwitch = document.querySelector('.lang-switch');
  const langBtn = langSwitch?.querySelector('.lang-current');
  langBtn?.addEventListener('click', () => {
    const open = langSwitch?.classList.toggle('open') ?? false;
    langBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (langSwitch && !langSwitch.contains(e.target as Node)) {
      langSwitch.classList.remove('open');
      langBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Cursor spotlight on dropdown
  document.querySelectorAll('.dropdown').forEach(dropdown => {
    dropdown.addEventListener('mousemove', (e) => {
      const r = dropdown.getBoundingClientRect();
      dropdown.style.setProperty('--mx', `${e.clientX - r.left}px`);
      dropdown.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
