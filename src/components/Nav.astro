---
import type { Lang } from '../i18n';
import { t, getOtherLang } from '../i18n';
import Icon from './Icon.astro';
import { getAlternateSlug } from '../data/blog-slugs';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const i = t(lang);
const otherLang = getOtherLang(lang);
const base = `/${lang}/`;
const currentPath = Astro.url.pathname;
let switchPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

// Handle jobs/vacatures URL translation
if (lang === 'en') {
  switchPath = switchPath.replace('/nl/jobs/', '/nl/vacatures/');
} else {
  switchPath = switchPath.replace('/en/vacatures/', '/en/jobs/');
}

// Handle blog post slug translation
const blogPrefix = lang === 'nl' ? '/nl/blog/' : '/en/blog/';
const altBlogPrefix = otherLang === 'nl' ? '/nl/blog/' : '/en/blog/';
if (currentPath.startsWith(blogPrefix) && currentPath !== blogPrefix) {
  const slug = currentPath.replace(blogPrefix, '').replace(/\/$/, '');
  if (slug) {
    const altSlug = getAlternateSlug(slug, lang);
    switchPath = `${altBlogPrefix}${altSlug}/`;
  }
}

const jobsPath = lang === 'nl' ? `${base}vacatures/` : `${base}jobs/`;

const serviceItems = [
  { href: `${base}ai/`, label: i.nav.ai },
  { href: `${base}sdn/`, label: i.nav.sdn },
  { href: `${base}ecommerce/`, label: i.nav.ecommerce },
  { href: `${base}openclaw/`, label: i.nav.openclaw },
];
---
<nav>
  <div class="container">
    <a href={base} class="logo"><img src="/logo.png" alt="Virge.io" class="logo-img" /></a>
    <button class="menu-toggle" aria-label="Menu" onclick="document.querySelector('.links').classList.toggle('open')">
      <Icon name="menu" size={24} />
    </button>
    <ul class="links">
      <li><a href={base}>{i.nav.home}</a></li>
      <li class="has-dropdown">
        <a href={`${base}services/`} class="dropdown-parent">
          {i.nav.services}
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <ul class="dropdown">
          {serviceItems.map(s => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </li>
      <li><a href={`${base}cases/`}>{i.nav.cases}</a></li>
      <li><a href={`${base}blog/`}>{i.nav.blog}</a></li>
      <li><a href={jobsPath}>{i.nav.jobs}</a></li>
      <li><a href={`${base}contact/`}>{i.nav.contact}</a></li>
      <li class="lang-switch">
        <a href={switchPath} class="lang-btn">{otherLang.toUpperCase()}</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .logo-img {
    height: 40px;
    width: auto;
  }
  .lang-switch {
    margin-left: 0.5rem;
  }
  .lang-btn {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(139,92,246,0.5);
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #a78bfa;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .lang-btn:hover {
    background: rgba(139,92,246,0.2);
    color: #c4b5fd;
  }

  /* Uniform link size */
  :global(nav .links a),
  :global(nav .links button) {
    font-size: 1.05rem;
  }

  /* Dropdown */
  .has-dropdown {
    position: relative;
  }
  .dropdown-parent {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.05rem;
  }
  .chevron {
    transition: transform 0.2s;
    opacity: 0.6;
  }
  .has-dropdown:hover .chevron {
    transform: rotate(180deg);
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.75rem;
    min-width: 180px;
    background: linear-gradient(160deg, #16143a 0%, #0d0c24 100%);
    border-radius: var(--radius);
    padding: 0.4rem;
    list-style: none;
    z-index: 200;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.1),
      0 12px 36px rgba(0,0,0,0.55),
      0 0 22px 4px rgba(108,92,231,0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.97);
    transform-origin: top left;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    overflow: hidden;
  }
  .dropdown::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      200px circle at var(--mx, -999px) var(--my, -999px),
      rgba(108,92,231,0.18),
      transparent 70%
    );
    pointer-events: none;
    border-radius: inherit;
  }
  .has-dropdown:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .dropdown li {
    display: block;
    width: 100%;
  }
  .dropdown li a {
    display: block;
    width: 100%;
    padding: 0.55rem 1rem;
    white-space: nowrap;
    color: rgba(255,255,255,0.6);
    font-size: 0.95rem;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }
  .dropdown li a:hover {
    color: #fff;
    background: rgba(108,92,231,0.2);
    text-decoration: none;
  }

  /* Mobile: dropdown becomes inline */
  @media (max-width: 768px) {
    .dropdown {
      position: static;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      padding: 0 0 0 0.5rem;
      margin-top: 0.25rem;
      transform: none;
      transition: none;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
    }
    .has-dropdown:hover .dropdown {
      opacity: 0;
      visibility: hidden;
    }
    .has-dropdown.open .dropdown {
      opacity: 1;
      visibility: visible;
      max-height: 200px;
    }
  }
</style>

<script>
  if (window.matchMedia('(max-width: 768px)').matches) {
    document.querySelectorAll('.has-dropdown .dropdown-parent').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        el.closest('.has-dropdown')?.classList.toggle('open');
      });
    });
  }

  // Cursor spotlight on dropdown
  document.querySelectorAll('.dropdown').forEach(dropdown => {
    dropdown.addEventListener('mousemove', (e) => {
      const r = dropdown.getBoundingClientRect();
      dropdown.style.setProperty('--mx', `${e.clientX - r.left}px`);
      dropdown.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
