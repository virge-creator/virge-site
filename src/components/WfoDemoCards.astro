---
import { wfoDemos } from '../data/wfo-demos';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
{wfoDemos.map(d => <a class="wfo-card" href={`/${lang}/cases/${d.slug}/`}>
  <div class="card-art" aria-hidden="true"><span>{d[lang].source}</span><strong>WFO ↔ {lang === 'en' ? 'Live network' : 'Netwerkstatus'}</strong><small>{d.ticket} · Amsterdam — Paris — London</small></div>
  <div class="card-label"><span class="demo-pill">Demo</span><span>WFO · A2A · MCP</span></div>
  <h3>{d[lang].title}</h3><p>{d[lang].intro}</p>
  <span class="card-link">{lang === 'en' ? 'Watch demo' : 'Bekijk de demo'} →</span>
</a>)}
<style>
.wfo-card{display:flex;flex-direction:column;gap:.9rem;padding:1rem;border:1px solid color-mix(in srgb, var(--accent) 25%, transparent);border-radius:12px;background:var(--surface);color:var(--text);text-decoration:none;transition:transform .2s}
.wfo-card:hover{transform:translateY(-3px);text-decoration:none;border-color:var(--link)}
.card-art{display:flex;flex-direction:column;justify-content:center;gap:.8rem;min-height:170px;padding:1.5rem;border-radius:8px;background:var(--bg);border:1px solid var(--link)}
.card-art strong{font-size:1.3rem}.card-art span,.card-art small,.card-label,.wfo-card p{color:var(--text-muted)}
.card-label{display:flex;align-items:center;gap:.8rem;font-size:.78rem}.demo-pill{border:1px solid var(--link);color:var(--link);padding:.2rem .6rem;border-radius:99px;font-size:.75rem}
h3{font-size:1.45rem;margin:0}p{font-size:.95rem;line-height:1.65;margin:0;flex:1}.card-link{color:var(--link);font-size:.85rem;border-top:1px solid color-mix(in srgb, var(--accent) 25%, transparent);padding-top:.75rem}
@media(prefers-reduced-motion:reduce){.wfo-card{transition:none}.wfo-card:hover{transform:none}}
</style>
