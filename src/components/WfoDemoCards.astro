---
import { wfoDemos } from '../data/wfo-demos';
import type { Lang } from '../i18n';
import Icon from './Icon.astro';
import WfoDemoThumbnail from './WfoDemoThumbnail.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
{wfoDemos.map(d => <a class="wfo-card" href={`/${lang}/cases/${d.slug}/`}>
  <div class="card-preview">
    <WfoDemoThumbnail ticket={d.ticket} lang={lang} />
  </div>
  <div class="card-copy">
    <div class="card-meta"><span class="demo-label">Demo</span>{d.kind === 'concept' ? <span class="ticket">{d[lang].source}</span> : <><span class="ticket">{d.ticket}</span><span>{d[lang].source}</span></>}</div>
    <h3>{d[lang].title}</h3>
    <p>{d[lang].intro}</p>
    {d.kind === 'concept'
      ? <div class="service-strip" aria-label="Workflow Orchestrator, LibreChat, CA, DNS, vault">
          <span><img class="wfo-logo" src="/images/cases/surf-orchestrator-core/wfo-logo.png" alt="" width="24" height="24" /><span>WFO</span></span>
          <span><img src="/images/cases/wfo-demos/librechat.svg" alt="" width="18" height="18" /><span>LibreChat</span></span>
          <span>{lang === 'en' ? 'CA · DNS · Vault · ITSM' : 'CA · DNS · Kluis · ITSM'}</span>
        </div>
      : <div class="service-strip" aria-label="Workflow Orchestrator, NetBox, LibreChat">
          <span><img class="wfo-logo" src="/images/cases/surf-orchestrator-core/wfo-logo.png" alt="" width="24" height="24" /><span>WFO</span></span>
          <span><img class="netbox-logo" src="/images/cases/wfo-demos/netbox.svg" alt="" width="64" height="24" /></span>
          <span><img src="/images/cases/wfo-demos/librechat.svg" alt="" width="18" height="18" /><span>LibreChat</span></span>
        </div>}
    <span class="card-link">{d.kind === 'concept' ? (lang === 'en' ? 'Explore the scenario' : 'Bekijk het scenario') : (lang === 'en' ? 'Watch demo' : 'Bekijk de demo')}<Icon name="arrow-right" size={18} /></span>
  </div>
</a>)}


<style>
  .wfo-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-card); color: var(--text); font-family: var(--font-body); text-decoration: none; transition: border-color .18s ease-out; }
  .wfo-card:hover { border-color: var(--link); text-decoration: none; }
  .wfo-card:focus-visible { outline: 2px solid var(--link); outline-offset: 5px; }
  .card-preview { container-type: inline-size; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg); border-bottom: 1px solid var(--border); }
  .card-copy { display: flex; flex-direction: column; flex: 1; gap: 1rem; padding: 1.5rem; }
  .card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; color: var(--text-muted); font-size: .7rem; }
  .demo-label { color: var(--text); font-weight: 600; }
  .demo-label--concept { color: var(--link); }
  .wfo-card--concept { border-style: dashed; }
  .service-strip :global(svg) { color: var(--link); }
  .ticket { font-variant-numeric: tabular-nums; color: var(--link); }
  h3 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.4; text-wrap: balance; margin: 0; }
  p { color: var(--text-muted); font-size: .9rem; line-height: 1.8; margin: 0; flex: 1; }
  .service-strip { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; color: var(--text-muted); font-size: .65rem; margin-top: .25rem; }
  .service-strip > span { display: inline-flex; align-items: center; gap: .35rem; }
  .service-strip img { display: block; object-fit: contain; }
  .wfo-logo { border-radius: 4px; }
  .service-strip .netbox-logo { padding: 3px 5px; background: #fff; border-radius: 4px; }
  .card-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1rem; margin-top: .15rem; border-top: 1px solid var(--border); color: var(--link); font-size: .85rem; font-weight: 500; }
  @media (max-width: 600px) {
    .card-copy { padding: 1.25rem; }
    h3 { font-size: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wfo-card { transition: none; }
  }
</style>
