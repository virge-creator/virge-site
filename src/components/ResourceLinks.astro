---
import Icon from './Icon.astro';

interface Resource {
  title: string;
  desc: string;
  href: string;
  /** lucide-static icon name */
  icon: string;
}

interface Props {
  title: string;
  intro?: string;
  links: Resource[];
  /** Smaller links shown under the grid, e.g. our own case or webinar. */
  related?: { label: string; href: string }[];
  relatedTitle?: string;
}

const { title, intro, links, related = [], relatedTitle } = Astro.props;
const isExternal = (href: string) => /^https?:/.test(href);
const host = (href: string) => new URL(href).hostname.replace(/^www\./, '');
---
<div class="resources">
  <h2>{title}</h2>
  {intro && <p class="resources-intro">{intro}</p>}
  <ul class="resources-grid">
    {links.map(l => (
      <li>
        <a href={l.href} target={isExternal(l.href) ? '_blank' : undefined} rel={isExternal(l.href) ? 'noopener' : undefined}>
          <span class="resources-icon"><Icon name={l.icon} size={20} /></span>
          <span class="resources-text">
            <strong>{l.title}</strong>
            <span>{l.desc}</span>
            {isExternal(l.href) && <span class="resources-host">{host(l.href)}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  {related.length > 0 && (
    <p class="resources-related">
      {relatedTitle && <span>{relatedTitle}:</span>}
      {related.map(r => <a href={r.href}>{r.label}</a>)}
    </p>
  )}
</div>

<style>
  .resources-intro { color: var(--text-muted); max-width: 640px; margin: -0.75rem 0 1.75rem; }
  .resources-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .resources-grid a {
    display: flex; gap: 0.9rem; height: 100%; padding: 1.15rem 1.2rem; border-radius: var(--radius);
    background: rgba(18,18,42,0.6); border: 1px solid rgba(108,92,231,0.18);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .resources-grid a:hover { text-decoration: none; border-color: rgba(108,92,231,0.5); background: rgba(108,92,231,0.1); transform: translateY(-2px); }
  .resources-icon {
    flex-shrink: 0; width: 2.4rem; height: 2.4rem; border-radius: 10px; display: grid; place-items: center;
    background: rgba(108,92,231,0.15); color: var(--link);
  }
  .resources-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .resources-text strong { color: #fff; font-size: 1rem; }
  .resources-text span { color: var(--text-muted); font-size: 0.88rem; line-height: 1.45; }
  .resources-text .resources-host { margin-top: auto; padding-top: 0.4rem; font-size: 0.78rem; color: var(--link); }
  .resources-related { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.5rem; font-size: 0.92rem; }
  .resources-related > span { color: var(--text-muted); }
</style>
