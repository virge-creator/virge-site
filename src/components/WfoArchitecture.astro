---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import ArchDiagram from './ArchDiagram.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang).sdn.arch;
const clientIcons = ['users', 'code-xml', 'bot'];
const systemIcons = ['server', 'terminal', 'plug'];
---
<ArchDiagram
  clientsLabel={a.clientsLabel}
  clients={a.clients.map((c, idx) => ({ ...c, icon: clientIcons[idx] }))}
  appLabel={a.appLabel}
  appSub={a.appSub}
  parts={a.parts}
  core={a.core}
  coreSub={a.coreSub}
  store={{ title: a.db, sub: a.dbSub, icon: 'database' }}
  systemsLabel={a.systemsLabel}
  systems={a.systems.map((s, idx) => ({ ...s, icon: systemIcons[idx] }))}
  target={{ title: a.network, icon: 'network' }}
  source={{ label: a.source, href: 'https://workfloworchestrator.org/architecture/framework/' }}
/>
