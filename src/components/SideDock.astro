---
import type { Lang } from '../i18n';
import Icon from './Icon.astro';
import ContactPanel from './ContactPanel.astro';
import { getUpcoming } from '../data/webinars';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const hasWebinars = getUpcoming().length > 0;
const label = en ? 'Discuss an integration' : 'Bespreek een integratie';
---
<div class="side-dock" data-side-dock>
  <div class="dock-tabs">
    <button type="button" class="dock-tab" data-dock-tab aria-expanded="false" aria-controls="dock-panel" title={label}>
      <Icon name="mail" size={18} />
      <span>{label}</span>
    </button>
  </div>

  <div class="dock-rail">
    <div class="dock-panel" id="dock-panel" data-dock-panel role="dialog" aria-label={label} tabindex="-1" hidden>
      <ContactPanel lang={lang} id="dock-contact" />
      <button type="button" class="dock-close" data-dock-close aria-label={en ? 'Close' : 'Sluiten'}><Icon name="x" size={18} /></button>
      {hasWebinars && (
        <a class="dock-webinar" href={`/${lang}/webinars/`}>
          <Icon name="presentation" size={16} />
          <span>{en ? 'or join one of our upcoming webinars' : 'of doe mee aan een van onze komende webinars'}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      )}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-side-dock]').forEach(dock => {
    const tab = dock.querySelector<HTMLButtonElement>('[data-dock-tab]')!;
    const panel = dock.querySelector<HTMLElement>('[data-dock-panel]')!;
    // Wide screens: like the blog's header overview, the card simply sits beside the article.
    const wide = matchMedia('(min-width: 1800px)');
    let isOpen = false;
    const set = (open: boolean, restoreFocus = false) => {
      isOpen = open;
      tab.setAttribute('aria-expanded', String(open));
      tab.classList.toggle('is-open', open);
      panel.hidden = !open && !wide.matches;
      if (open) panel.focus({ preventScroll: true });
      else if (restoreFocus) tab.focus();
    };
    // Wide screens: the card starts level with the bottom of the page header (where the recording begins),
    // scrolls up with the page, and settles at the middle of the viewport.
    const rail = dock.querySelector<HTMLElement>('.dock-rail')!;
    let frame = 0;
    const place = () => {
      frame = 0;
      dock.classList.toggle('is-placed', wide.matches);
      if (!wide.matches) return;
      const navHeight = document.querySelector('nav')?.getBoundingClientRect().height ?? 72;
      const header = document.querySelector('.demo-header');
      const start = header ? header.getBoundingClientRect().bottom + scrollY : navHeight + 16;
      const height = rail.offsetHeight;
      const floor = navHeight + 16;
      const middle = Math.max(floor, (innerHeight - height) / 2);
      const top = Math.min(Math.max(middle, start - scrollY), innerHeight - height - 16);
      rail.style.setProperty('--rail-top', `${Math.max(floor, top)}px`);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(place); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    new ResizeObserver(schedule).observe(rail);
    const layout = () => {
      panel.setAttribute('role', wide.matches ? 'region' : 'dialog');
      set(false);
      place();
    };
    wide.addEventListener('change', layout);
    layout();
    tab.addEventListener('click', () => set(!isOpen));
    dock.querySelector('[data-dock-close]')!.addEventListener('click', () => set(false, true));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && isOpen) set(false, true);
    });
    document.addEventListener('pointerdown', event => {
      if (isOpen && !dock.contains(event.target as Node)) set(false);
    });
  });
</script>

<style>
  .side-dock { position: fixed; inset: 0 auto 0 0; z-index: 150; pointer-events: none; }
  .side-dock > * { pointer-events: auto; }
  .dock-tabs { position: fixed; left: 0; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: .5rem; }
  .dock-tab {
    display: flex; align-items: center; gap: .65rem; writing-mode: vertical-rl;
    padding: 1.1rem .7rem; border: 1px solid var(--accent-btn); border-left: 0; border-radius: 0 12px 12px 0;
    background: var(--accent-btn); color: #fff; font: inherit; font-size: .8rem; font-weight: 600; letter-spacing: .02em;
    cursor: pointer;
    transition: background .18s ease-out, padding .18s ease-out;
  }
  .dock-tab :global(svg) { color: #fff; flex-shrink: 0; }
  .dock-tab:hover, .dock-tab.is-open { padding-left: .95rem; background: var(--accent-btn-hover); }
  .dock-tab:focus-visible { outline: 2px solid var(--link); outline-offset: -3px; }

  .dock-rail { display: contents; }
  .dock-panel {
    position: fixed; left: 3.5rem; top: 50%; transform: translateY(-50%);
    width: min(400px, calc(100vw - 5.5rem)); max-height: calc(100dvh - 5.5rem); overflow-y: auto;
    border-radius: 18px; background: var(--bg);
    animation: dockIn .22s ease-out;
  }
  .dock-panel[hidden] { display: none; }
  .dock-panel:focus { outline: none; }
  @keyframes dockIn { from { opacity: 0; transform: translateY(-50%) translateX(-12px); } to { opacity: 1; transform: translateY(-50%); } }
  .dock-close {
    position: absolute; top: .85rem; right: .85rem; display: grid; place-items: center; width: 32px; height: 32px;
    border: 0; border-radius: 50%; background: transparent; color: var(--text-muted); cursor: pointer;
  }
  .dock-close:hover { color: #fff; background: rgba(255,255,255,.08); }
  .dock-close:focus-visible { outline: 2px solid var(--link); }

  /* A plain button as wide as the card, with a gap above it. */
  .dock-webinar {
    display: flex; align-items: center; justify-content: center; gap: .55rem;
    width: 100%; margin: .75rem 0 0; padding: .7rem 1rem;
    border: 1px solid rgba(108,92,231,.4); border-radius: 18px;
    background: rgb(18,18,42); color: var(--link); font-size: .85rem; font-weight: 600; line-height: 1.4; text-align: center;
    transition: background .18s ease-out, color .18s ease-out, border-color .18s ease-out;
  }
  .dock-webinar :global(svg) { flex-shrink: 0; }
  .dock-webinar:hover { background: rgba(108,92,231,.22); border-color: var(--link); color: #fff; text-decoration: none; }
  .dock-webinar:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }

  /* Wide screens: no tab. The card sits right beside the article (1100px, centred) on its left, starts level with the bottom of the page header and settles at the middle of the viewport height while scrolling. */
  @media (min-width: 1800px) {
    .dock-tabs, .dock-close { display: none; }
    .dock-rail {
      display: block; position: fixed; top: 50%; transform: translateY(-50%); right: calc(50% + 550px + 1.5rem); width: 19rem;
      max-height: calc(100dvh - 7rem); overflow-y: auto; scrollbar-width: thin; padding: 2px;
    }
    .dock-panel { position: static; transform: none; width: auto; max-height: none; overflow: visible; animation: none; background: none; box-shadow: none; }
    .dock-rail :global(.cp-fields) { grid-template-columns: 1fr; }
    /* Script-driven position (see place()); the centred default above is the no-JS fallback. */
    .is-placed .dock-rail { top: var(--rail-top); transform: none; }
  }

  @media (max-width: 700px) {
    .dock-tabs { top: auto; bottom: 1rem; left: 1rem; transform: none; }
    .dock-tab { writing-mode: horizontal-tb; width: 48px; height: 48px; padding: 0; justify-content: center; border: 1px solid rgba(108,92,231,.5); border-radius: 50%; box-shadow: 0 10px 28px -10px rgba(0,0,0,.7); }
    .dock-tab span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .dock-tab:hover, .dock-tab.is-open { padding: 0; }
    .dock-panel { right: .75rem; left: .75rem; width: auto; top: auto; bottom: 4.9rem; transform: none; max-height: calc(100dvh - 7rem); animation-name: dockInMobile; }
    @keyframes dockInMobile { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-panel { animation: none; }
    .dock-tab, .dock-webinar { transition: none; }
  }
</style>
