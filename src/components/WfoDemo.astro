---
import Layout from '../layouts/Layout.astro';
import WfoDemoSetup from './WfoDemoSetup.astro';
import { wfoDemos, type WfoTicket } from '../data/wfo-demos';
import { breadcrumbSchema } from '../data/structured-data';
import type { Lang } from '../i18n';
interface Props { lang: Lang; ticket: WfoTicket }
const { lang, ticket } = Astro.props;
const d = wfoDemos.find(d => d.ticket === ticket)!;
const c = d[lang];
const en = lang === 'en';
const base = `/videos/wfo-demos/${ticket}`;
const capabilities = en ? ['Resolve sites and interfaces to WFO subscriptions, UUIDs and customers.', 'Query specialist agents over A2A, using MCP tools for WFO, NetBox and network data.', 'Correlate stored configuration with device state and path measurements.'] : ['Koppel locaties en poorten aan WFO-subscriptions, UUID’s en klanten.', 'Bevraag gespecialiseerde agents via A2A, met MCP-tools voor WFO, NetBox en netwerkdata.', 'Combineer opgeslagen configuratie met apparaatstatus en padmetingen.'];
const faqs = [
 [en ? 'Is this a production incident?' : 'Is dit een productiestoring?', en ? 'No. These are example tickets in an emulated three-node network. Real SR Linux instances carry the lab traffic. Static tickets stand in for a ticket system; automatic ticket-system integration is not demonstrated.' : 'Nee. Dit zijn voorbeeldtickets in een nagebootst netwerk met drie nodes. Echte SR Linux-instances verwerken het labverkeer. Statische tickets vervangen een ticketsysteem; een automatische koppeling met zo’n systeem wordt hier niet getoond.'],
 [en ? 'Does the assistant make changes?' : 'Voert de assistent wijzigingen uit?', en ? 'This demo is read-only. It reports findings and recommends next steps. An operator must authorize restoration or maintenance separately; no repair, port change or maintenance flag update occurs in the recording.' : 'Deze demo leest alleen. De assistent geeft bevindingen en vervolgstappen. Een operator moet herstel of onderhoud apart goedkeuren; de opname toont geen reparatie, poortwijziging of aangepaste onderhoudsvlag.'],
 [en ? 'Is the recording real time?' : 'Is de opname in realtime?', en ? 'The silent English recording is about 70 seconds long. Model waiting has been compressed; this is an edited demonstration, not a benchmark. The final comparison and recap combine recorded WFO intent with independently captured device evidence.' : 'De Engelstalige opname zonder geluid duurt ongeveer 70 seconden. Wachttijd van het model is ingekort; dit is een gemonteerde demonstratie, geen benchmark. De vergelijking en samenvatting combineren WFO-configuratie met onafhankelijk vastgelegde apparaatmetingen.']
];
---
<Layout title={c.title} description={c.intro} lang={lang} ogImage={`${base}.webp`} jsonLd={breadcrumbSchema([{name:'Home',path:`/${lang}/`},{name:'Cases',path:`/${lang}/cases/`},{name:c.title,path:`/${lang}/cases/${d.slug}/`}])}>
<article class="wfo-demo container">
<a href={`/${lang}/cases/`} class="back">← {en ? 'All cases' : 'Alle cases'}</a>
<header class="demo-hero">
<div><span class="pill">Demo</span> <span class="muted">{ticket} · {c.source}</span><h1>{c.title}</h1><p class="lead">{c.intro}</p>
<div class="result"><span>{c.source} →</span><strong>{en ? 'Service mapping · live diagnostics' : 'Dienstkoppeling · live diagnostiek'}</strong></div>
<a href="#setup">{en ? 'See the setup' : 'Bekijk de opstelling'} ↓</a></div>
<figure class="recording"><video data-wfo-video controls muted playsinline loop preload="metadata" poster={`${base}.webp`} aria-label={c.title}><source src={`${base}.mp4`} type="video/mp4" /><a href={`${base}.mp4`}>{en ? 'Download the recording' : 'Download de opname'}</a></video><figcaption>{en ? '≈70 seconds · silent · edited waiting time · emulated lab' : '≈70 seconden · zonder geluid · wachttijd ingekort · nagebootst netwerk'}</figcaption></figure>
</header>
<section class="capabilities" aria-label={en ? 'Capabilities and findings' : 'Mogelijkheden en bevindingen'}>
<div><h2>{en ? 'What the agent does' : 'Wat de agent doet'}</h2><ul>{capabilities.map(step=><li>{step}</li>)}</ul><details><summary>{en ? 'The exact request' : 'De exacte vraag (Engels)'}</summary><blockquote>{d.prompt}</blockquote></details></div>
<div class="answer"><h2>{en ? 'Diagnostic findings' : 'Diagnostische bevindingen'}</h2><p>{c.finding}</p><p>{c.outcome}</p></div>
</section>
<section id="setup"><WfoDemoSetup lang={lang} /></section>
<section class="review"><div><h2>{en ? 'Validation and execution boundaries' : 'Validatie en uitvoeringsgrenzen'}</h2><ul><li>{en ? 'Confirm the subscription UUID, customer and exact interface.' : 'Controleer subscription-UUID, klant en exacte poort.'}</li><li>{en ? 'Compare stored intent with fresh device evidence; active or in sync does not prove live health.' : 'Vergelijk de configuratie met actuele metingen; actief of in sync bewijst geen gezonde verbinding.'}</li><li>{en ? 'Review the diagnosis and approve any follow-up change separately.' : 'Beoordeel de diagnose en keur een vervolgwijziging apart goed.'}</li></ul></div><div><h2>{en ? 'Questions about this demo' : 'Vragen over deze demo'}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
<footer class="closing"><h2>{en ? 'Explore the implementation' : 'Bekijk de implementatie'}</h2><p>{en ? 'Explore the agent and example stack. The network specialist and containerlab extend the base agent setup shown in the documentation.' : 'Bekijk de agent en de voorbeeldomgeving. De netwerkspecialist en containerlab breiden de basisopstelling uit de documentatie uit.'}</p><div class="links"><a href="https://workfloworchestrator.org/">WFO {en ? 'documentation' : 'documentatie'} ↗</a><a href="https://github.com/workfloworchestrator/orchestrator-agent">Orchestrator Agent ↗</a><a href="https://github.com/workfloworchestrator/example-orchestrator">Example Orchestrator ↗</a></div><p class="question">{en ? 'Connect specialist agents to your service and network APIs.' : 'Koppel gespecialiseerde agents aan je service- en netwerk-API’s.'}</p><a class="btn" href={`/${lang}/contact/`}>{en ? 'Discuss an integration' : 'Bespreek een integratie'} →</a></footer>
</article>
</Layout>
<script>
const desktop = matchMedia('(min-width: 900px)');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll<HTMLVideoElement>('[data-wfo-video]').forEach(video => {
 const sync = () => { if (desktop.matches && !motion.matches) video.play().catch(() => {}); else video.pause(); };
 sync(); desktop.addEventListener('change', sync); motion.addEventListener('change', sync);
});
</script>
<style>
  .wfo-demo { padding-top: 2rem; padding-bottom: 2.5rem; }
  .wfo-demo > section { padding: 0; }
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: .9rem; }
  .demo-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 2rem;
    align-items: center;
    padding-top: 1.25rem;
  }
  .demo-hero::before {
    content: '';
    position: absolute;
    inset: -2rem 0 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 75% 35%, rgba(108,92,231,.035), transparent 65%);
  }
  .demo-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rem;
    height: 1px;
    background: var(--gradient);
  }
  .demo-hero > div { min-width: 0; }
  h1 { font-size: clamp(2rem,3.2vw,3.1rem); line-height: 1.12; margin: .75rem 0; color: #fff; }
  h2 { font-size: 1.3rem; margin-bottom: .75rem; }
  .lead { font-size: 1rem; color: var(--text-muted); line-height: 1.65; }
  .muted { font-size: .8rem; color: var(--text-muted); }
  .pill { display: inline-block; border: 1px solid rgba(168,85,247,.4); background: rgba(108,92,231,.14); color: var(--link); border-radius: 99px; padding: .15rem .65rem; font-size: .75rem; }
  .result { display: flex; flex-direction: column; gap: .2rem; padding: .65rem .9rem; border-left: 3px solid var(--accent2); background: linear-gradient(90deg,rgba(108,92,231,.04),transparent); margin: 1rem 0; border-radius: 0 8px 8px 0; }
  .result span { color: var(--text-muted); font-size: .8rem; }
  .result strong { font-size: .95rem; }
  .recording { margin: 0; min-width: 0; }
  video { display: block; width: 100%; aspect-ratio: 16/9; border: 1px solid rgba(108,92,231,.3); border-radius: 12px; background: #0b1729; box-shadow: 0 8px 24px rgba(0,0,0,.16); }
  figcaption { font-size: .75rem; color: var(--text-muted); margin-top: .5rem; }
  .capabilities, .review { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.75rem 0; }
  .capabilities > div, .review > div { min-width: 0; padding: 1.25rem; border: 1px solid rgba(108,92,231,.22); border-radius: 16px; background: rgba(18,18,42,.7); }
  .capabilities > .answer { border-color: rgba(168,85,247,.4); background: radial-gradient(100% 80% at 0% 0%,rgba(108,92,231,.04),transparent 60%),rgba(18,18,42,.7); }
  .answer h2 { color: var(--link); }
  p, li { line-height: 1.65; }
  .capabilities p, .review li { font-size: .95rem; }
  .answer > p + p { margin-top: .65rem; }
  li { margin-bottom: .45rem; }
  li:last-child { margin-bottom: 0; }
  ol, ul { padding-left: 1.3rem; }
  li::marker { color: var(--link); }
  details { border-bottom: 1px solid rgba(108,92,231,.2); padding: .65rem 0; }
  details:last-child { border-bottom: 0; }
  summary { cursor: pointer; color: var(--link); line-height: 1.5; font-size: .95rem; }
  summary:hover { color: #fff; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; border-radius: 4px; }
  details p, blockquote { font-size: .9rem; margin: .65rem 0; overflow-wrap: anywhere; }
  blockquote { border-left: 2px solid var(--accent2); padding-left: .8rem; }
  .closing { padding: 1.5rem; border: 1px solid rgba(108,92,231,.25); border-radius: 16px; background: radial-gradient(100% 100% at 0% 0%,rgba(108,92,231,.035),transparent 60%),rgba(18,18,42,.7); }
  .closing p { max-width: 75ch; color: var(--text-muted); font-size: .95rem; }
  .links { display: flex; gap: .5rem 1.25rem; flex-wrap: wrap; margin-top: .75rem; font-size: .9rem; }
  .closing .question { margin: 1rem 0 .75rem; font-size: 1.05rem; color: var(--text); }
  #setup { scroll-margin-top: 6rem; }
  @media (max-width: 900px) {
    .demo-hero { grid-template-columns: 1fr; gap: 1.25rem; }
    .wfo-demo { padding-top: 1.5rem; }
  }
  @media (max-width: 700px) {
    .capabilities, .review { grid-template-columns: 1fr; gap: .75rem; margin: 1.25rem 0; }
    .capabilities > div, .review > div, .closing { padding: 1rem; }
  }
</style>
