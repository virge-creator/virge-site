---
import Layout from '../layouts/Layout.astro';
import WfoDemoSetup from './WfoDemoSetup.astro';
import Icon from './Icon.astro';
import SideDock from './SideDock.astro';
import { wfoDemos, type WfoTicket } from '../data/wfo-demos';
import { breadcrumbSchema } from '../data/structured-data';
import type { Lang } from '../i18n';
interface Props { lang: Lang; ticket: WfoTicket }
const { lang, ticket } = Astro.props;
const d = wfoDemos.find(d => d.ticket === ticket)!;
const c = d[lang];
const en = lang === 'en';
const base = `/videos/wfo-demos/${ticket}`;
const capabilities = en ? ['Resolve sites and interfaces to WFO subscriptions, UUIDs and customers.', 'Query specialist agents over A2A, using MCP tools for WFO, NetBox and network data.', 'Correlate stored configuration with device state and path measurements.'] : ['Koppel locaties en poorten aan WFO-subscriptions, UUID’s en klanten.', 'Bevraag gespecialiseerde agents via A2A, met MCP-tools voor WFO, NetBox en netwerkdata.', 'Combineer opgeslagen configuratie met apparaatstatus en padmetingen.'];
const faqs = [
 [en ? 'Is this a production incident?' : 'Is dit een productiestoring?', en ? 'No. These are example tickets in an emulated three-node network. Real SR Linux instances carry the lab traffic. Static tickets stand in for a ticket system; automatic ticket-system integration is not demonstrated.' : 'Nee. Dit zijn voorbeeldtickets in een nagebootst netwerk met drie nodes. Echte SR Linux-instances verwerken het labverkeer. Statische tickets vervangen een ticketsysteem; een automatische koppeling met zo’n systeem wordt hier niet getoond.'],
 [en ? 'Does the assistant make changes?' : 'Voert de assistent wijzigingen uit?', en ? 'This demo is read-only. It reports findings and recommends next steps. An operator must authorize restoration or maintenance separately; no repair, port change or maintenance flag update occurs in the recording.' : 'Deze demo leest alleen. De assistent geeft bevindingen en vervolgstappen. Een operator moet herstel of onderhoud apart goedkeuren; de opname toont geen reparatie, poortwijziging of aangepaste onderhoudsvlag.'],
 [en ? 'Is the recording real time?' : 'Is de opname in realtime?', en ? 'The silent English recording is about 70 seconds long. Model waiting has been compressed; this is an edited demonstration, not a benchmark. The final comparison and recap combine recorded WFO intent with independently captured device evidence.' : 'De Engelstalige opname zonder geluid duurt ongeveer 70 seconden. Wachttijd van het model is ingekort; dit is een gemonteerde demonstratie, geen benchmark. De vergelijking en samenvatting combineren WFO-configuratie met onafhankelijk vastgelegde apparaatmetingen.']
];
// Every other WFO demo and use case, linked from the closing section.
const moreDemos = [
  ...wfoDemos.filter(x => x.ticket !== ticket).map(x => ({ slug: x.slug, title: x[lang].title, tag: x.kind === 'recording' ? `Demo · ${x.ticket}` : x[lang].source })),
];
const validation = en ? [
  ['Confirm the target. ', 'Check that the subscription UUID, customer and exact interface match the ticket, so the diagnosis is not about a neighbouring service.'],
  ['Compare intent with evidence. ', 'WFO stores what should be configured; the device reports what is happening. A subscription that is active or in sync does not prove the link is healthy, so both sources are read.'],
  ['Keep changes separate. ', 'The agent never restores a port or edits a maintenance flag in this demo. An operator reviews the diagnosis and approves any follow-up as its own step.'],
] : [
  ['Controleer het doel. ', 'Controleer of subscription-UUID, klant en exacte poort overeenkomen met de melding, zodat de diagnose niet over een naastgelegen dienst gaat.'],
  ['Vergelijk configuratie met metingen. ', 'WFO bewaart wat er geconfigureerd hoort te zijn; het apparaat meldt wat er gebeurt. Een actieve of gesynchroniseerde subscription bewijst geen gezonde verbinding, dus beide bronnen worden gelezen.'],
  ['Houd wijzigingen apart. ', 'In deze demo herstelt de agent geen poort en past hij geen onderhoudsvlag aan. Een operator beoordeelt de diagnose en keurt een vervolgstap afzonderlijk goed.'],
];
---
<Layout title={c.title} description={c.intro} lang={lang} ogImage={`${base}.webp`} jsonLd={breadcrumbSchema([{ name: 'Home', path: `/${lang}/` }, { name: 'Cases', path: `/${lang}/cases/` }, { name: 'WFO Agent Demos', path: `/${lang}/cases/wfo-demos/` }, { name: c.title, path: `/${lang}/cases/${d.slug}/` }])}>
  <article class="wfo-demo container">
    <header class="demo-header">
      <div class="page-meta">
        <a href={`/${lang}/cases/wfo-demos/`} class="back"><Icon name="arrow-left" size={16} />{en ? 'All WFO demos' : 'Alle WFO-demo’s'}</a>
        <div class="scenario"><span class="demo-label">Demo</span><span class="ticket">{ticket}</span><span>{c.source}</span></div>
      </div>
      <div class="heading-grid">
        <h1>{c.title}</h1>
        <p class="lead">{c.intro}</p>
      </div>
      <div class="demo-context">
        <span><Icon name="workflow" size={16} />{en ? 'Service mapping · live diagnostics' : 'Dienstkoppeling · live diagnostiek'}</span>
        <a href="#setup">{en ? 'See the setup' : 'Bekijk de opstelling'}<Icon name="arrow-down" size={15} /></a>
      </div>
    </header>

    <section class="watch-grid" aria-label={en ? 'Recording and findings' : 'Opname en bevindingen'}>
      <figure class="recording">
        <video data-wfo-video controls muted playsinline loop preload="none" poster={`/images/cases/wfo-demos/previews/${ticket}.webp`} aria-label={c.title}>
          <source src={`${base}.mp4`} type="video/mp4" />
          <a href={`${base}.mp4`}>{en ? 'Download the recording' : 'Download de opname'}</a>
        </video>
        <figcaption>
          <span><Icon name="volume-x" size={14} />{en ? '≈70 seconds · silent · English' : '≈70 seconden · zonder geluid · Engels'}</span>
          <span>{en ? 'Edited waiting time · emulated lab' : 'Wachttijd ingekort · nagebootst netwerk'}</span>
        </figcaption>
      </figure>
      <aside class="findings" aria-labelledby="findings-heading">
        <div class="finding-body">
          <h2 id="findings-heading">{en ? 'Diagnostic findings' : 'Diagnostische bevindingen'}</h2>
          <p>{c.finding}</p>
        </div>
        <div class="finding-outcome">
          <h3>{en ? 'Impact and next steps' : 'Impact en vervolgstappen'}</h3>
          <p>{c.outcome}</p>
        </div>
        <span class="read-only"><Icon name="shield-check" size={16} />{en ? 'Read-only demonstration' : 'Demo zonder wijzigingen'}</span>
      </aside>
    </section>

    <section class="capabilities section-row" aria-labelledby="capabilities-heading">
      <div class="section-intro"><h2 id="capabilities-heading">{en ? 'What the agent does' : 'Wat de agent doet'}</h2></div>
      <div class="method-content">
        <ul class="capability-list">
          {capabilities.map((step, i) => <li><span class="method-icon" aria-hidden="true"><Icon name={['scan-search', 'git-branch', 'activity'][i]} size={21} /></span><span>{step}</span></li>)}
        </ul>
      </div>
    </section>

    <section id="setup" aria-label={en ? 'Multi-agent architecture' : 'Multi-agentarchitectuur'}>
      <WfoDemoSetup lang={lang}>
        <div class="request" slot="entry">
          <h3>{en ? 'The exact request' : 'De exacte vraag (Engels)'}</h3>
          <blockquote>{d.prompt}</blockquote>
        </div>
      </WfoDemoSetup>
    </section>

    <section class="review" aria-label={en ? 'Validation and questions' : 'Validatie en vragen'}>
      <div class="validation">
        <h2>{en ? 'Validation and execution boundaries' : 'Validatie en uitvoeringsgrenzen'}</h2>
        <p class="validation-intro">{en ? 'The agent investigates and recommends; people decide and act. Each step keeps a finding tied to evidence and keeps any change under operator control.' : 'De agent onderzoekt en adviseert; mensen beslissen en voeren uit. Elke stap houdt een bevinding aan bewijs gekoppeld en laat elke wijziging bij de operator.'}</p>
        <ul>
          {validation.map(([title, text]) => <li><Icon name="check" size={17} /><span><strong>{title}</strong>{text}</span></li>)}
        </ul>
      </div>
      <div class="questions">
        <h2>{en ? 'Questions about this demo' : 'Vragen over deze demo'}</h2>
        {faqs.map(([q, a]) => <details><summary><span>{q}</span><Icon name="plus" size={18} /></summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="closing" aria-labelledby="implementation-heading">
      <div>
        <h2 id="implementation-heading">{en ? 'Explore the implementation' : 'Bekijk de implementatie'}</h2>
        <p>{en ? 'Explore the agent and example stack. The network specialist and containerlab extend the base agent setup shown in the documentation.' : 'Bekijk de agent en de voorbeeldomgeving. De netwerkspecialist en containerlab breiden de basisopstelling uit de documentatie uit.'}</p>
        <div class="source-links">
          <a href="https://workfloworchestrator.org/">WFO {en ? 'documentation' : 'documentatie'}<Icon name="arrow-up-right" size={17} /></a>
          <a href="https://github.com/workfloworchestrator/orchestrator-agent">Orchestrator Agent<Icon name="arrow-up-right" size={17} /></a>
          <a href="https://github.com/workfloworchestrator/example-orchestrator">Example Orchestrator<Icon name="arrow-up-right" size={17} /></a>
        </div>
      </div>
      <nav class="more-demos" aria-labelledby="more-demos-heading">
        <h3 id="more-demos-heading">{en ? 'More WFO demos' : 'Meer WFO-demo’s'}</h3>
        <ul>
          {moreDemos.map(x => <li><a href={`/${lang}/cases/${x.slug}/`}><span class="more-title">{x.title}<small>{x.tag}</small></span><Icon name="arrow-right" size={17} /></a></li>)}
        </ul>
      </nav>
    </section>
  </article>
  <SideDock lang={lang} />
</Layout>

<script>
  const desktop = matchMedia('(min-width: 901px)');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('[data-wfo-video]').forEach(video => {
    const sync = () => {
      if (desktop.matches && !motion.matches) video.play().catch(() => {});
      else video.pause();
    };
    sync();
    desktop.addEventListener('change', sync);
    motion.addEventListener('change', sync);
  });
</script>

<style>
  .wfo-demo { max-width: 1240px; padding-top: 2rem; padding-bottom: 4rem; }
  .wfo-demo > section { padding: 0; }
  .wfo-demo :is(a, summary, video, [tabindex]):focus-visible { outline: 2px solid var(--link); outline-offset: 5px; }
  .page-meta, .scenario, .back, .demo-context, .demo-context > span, .demo-context a { display: flex; align-items: center; }
  .page-meta { justify-content: space-between; gap: 1rem; margin-bottom: 2.75rem; font-size: .8rem; }
  .back { gap: .55rem; color: var(--text-muted); }
  .back:hover { color: var(--text); }
  .scenario { flex-wrap: wrap; gap: .75rem; color: var(--text-muted); }
  .demo-label { padding: .2rem .65rem; border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-weight: 600; }
  .ticket { font-variant-numeric: tabular-nums; color: var(--link); }
  h1 { font-size: clamp(2rem, 3.8vw, 3.25rem); line-height: 1.16; margin: 0; max-width: 30ch; text-wrap: balance; color: var(--text); }
  .lead { color: var(--text-muted); font-size: 1rem; line-height: 1.8; max-width: 64ch; margin: 1.1rem 0 0; }
  .demo-context { justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 1.5rem 0; margin-top: 1.5rem; border-top: 1px solid var(--border); font-size: .8rem; }
  .demo-context > span { gap: .55rem; color: var(--text-muted); }
  .demo-context a { gap: .5rem; }
  .watch-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-areas: 'video findings' 'caption .'; column-gap: 1.75rem; align-items: stretch; }
  /* The figure's children join the grid so the findings card ends exactly at the video's bottom edge, not at the caption. */
  .recording { display: contents; }
  /* Stretch so the recording always matches the findings card, even when its text is taller than a 16:9 frame. */
  video { grid-area: video; align-self: stretch; object-fit: contain; display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-card); }
  figcaption { grid-area: caption; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .4rem 1rem; font-size: .7rem; line-height: 1.6; color: var(--text-muted); padding-top: .75rem; }
  figcaption span:first-child { display: inline-flex; align-items: center; gap: .4rem; }
  .findings { grid-area: findings; display: flex; flex-direction: column; min-width: 0; padding: 1.5rem; background: var(--bg-card); border-radius: 12px; }
  h2 { font-size: 1.45rem; line-height: 1.35; margin: 0 0 1.25rem; }
  .findings h2 { font-size: 1.1rem; margin-bottom: .85rem; }
  .findings p { font-size: .9rem; line-height: 1.8; }
  .finding-outcome { margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .finding-outcome h3 { font-family: var(--font-body); letter-spacing: 0; font-size: .8rem; margin: 0 0 .55rem; color: var(--text-muted); }
  .finding-outcome p { color: var(--text-muted); }
  .read-only { display: flex; align-items: center; gap: .5rem; margin-top: auto; padding-top: 1.25rem; color: var(--link); font-size: .72rem; }
  .section-row { display: grid; grid-template-columns: 1fr 2fr; gap: 3.5rem; }
  .wfo-demo > .capabilities { padding-top: 2.5rem; margin: 2.75rem 0 1rem; border-top: 1px solid var(--border); }
  .section-intro h2 { max-width: 18ch; }
  .capability-list, .validation ul { margin: 0; padding: 0; list-style: none; }
  .capability-list li { display: flex; align-items: start; gap: 1rem; padding: 0 0 1.2rem; font-size: .95rem; line-height: 1.75; }
  .method-icon { display: inline-flex; flex-shrink: 0; color: var(--link); padding-top: .2rem; }
  details { border-bottom: 1px solid var(--border); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 54px; padding: .85rem 0; list-style: none; cursor: pointer; color: var(--text); font-size: .9rem; font-weight: 500; line-height: 1.6; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { color: var(--link); flex-shrink: 0; transition: transform .2s ease-out; }
  details[open] > summary :global(svg) { transform: rotate(45deg); }
  summary:hover { color: var(--link); }
  .request { max-width: 40rem; border-bottom: 1px solid var(--border); padding-bottom: 1.1rem; }
  .request h3 { display: flex; align-items: center; min-height: 54px; margin: 0; font-family: var(--font-body); letter-spacing: 0; font-size: .9rem; font-weight: 500; line-height: 1.6; color: var(--text); } /* 54px keeps its centre on the connector from You */
  blockquote { margin: 0; padding: 0; color: var(--text-muted); font-size: .95rem; line-height: 1.8; max-width: 70ch; overflow-wrap: anywhere; }
  #setup { scroll-margin-top: 6rem; }
  .wfo-demo > .review { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding-top: 2.75rem; margin: 2.75rem 0; border-top: 1px solid var(--border); }
  .validation h2 { max-width: 25ch; }
  .validation-intro { margin: -.5rem 0 1.5rem; max-width: 52ch; color: var(--text-muted); font-size: .9rem; line-height: 1.8; }
  .validation strong { display: block; color: var(--text); font-weight: 600; }
  .validation li { display: flex; align-items: start; gap: .8rem; font-size: .9rem; line-height: 1.8; color: var(--text-muted); margin: 0 0 1rem; }
  .validation li :global(svg) { flex-shrink: 0; margin-top: .35rem; color: var(--link); }
  .questions h2 { margin-bottom: .4rem; }
  .questions details p { margin: 0 0 1.2rem; color: var(--text-muted); line-height: 1.8; font-size: .9rem; }
  .wfo-demo > .closing { display: grid; grid-template-columns: 1.25fr 1fr; gap: 5rem; padding-top: 2.75rem; margin-top: 3rem; border-top: 1px solid var(--border); }
  .closing p { color: var(--text-muted); font-size: .9rem; line-height: 1.8; max-width: 65ch; }
  .source-links { display: flex; flex-direction: column; gap: .25rem; margin-top: 1.25rem; max-width: 28rem; }
  .source-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .55rem 0; font-size: .9rem; }
  .more-demos { border-left: 1px solid var(--border); padding-left: 2rem; }
  .more-demos h3 { margin: 0 0 .75rem; font-family: var(--font-body); letter-spacing: 0; font-size: 1rem; }
  .more-demos ul { margin: 0; padding: 0; list-style: none; }
  .more-demos li + li { border-top: 1px solid var(--border); }
  .more-demos a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 0; font-size: .9rem; line-height: 1.5; color: var(--text); }
  .more-demos a:hover { color: var(--link); text-decoration: none; }
  .more-demos a :global(svg) { flex-shrink: 0; color: var(--link); }
  .more-title { display: flex; flex-direction: column; gap: .1rem; }
  .more-title small { color: var(--text-muted); font-size: .72rem; }
  /* Keep the fixed side tab off the content edge when the page is narrower than container + tabs. */
  @media (min-width: 701px) and (max-width: 1340px) { .wfo-demo { padding-left: 4rem; } }
  /* Room for the always-visible side cards (see SideDock) in the left margin. */
  @media (min-width: 1800px) { .wfo-demo { max-width: 1100px; } }
  @media (max-width: 1050px) {
    .watch-grid { grid-template-columns: 1fr; grid-template-areas: 'video' 'caption' 'findings'; }
    video { align-self: start; }
    .findings { display: grid; grid-template-columns: 1fr 1fr; column-gap: 2rem; margin-top: 1.5rem; padding: 1.5rem; }
    .finding-outcome { margin: 0; padding: 0 0 0 1.5rem; border-top: 0; border-left: 1px solid var(--border); }
    .read-only { grid-column: 1 / -1; }
    .wfo-demo > .closing { gap: 2.5rem; }
  }
  @media (max-width: 900px) {
    h1 { max-width: 25ch; font-size: clamp(2rem, 5vw, 3rem); }
    .lead { max-width: 72ch; }
    .section-row { grid-template-columns: 1fr; gap: .5rem; }
    .section-intro h2 { max-width: none; }
    .wfo-demo > .review { gap: 2rem; }
  }
  @media (max-width: 600px) {
    .wfo-demo { padding-top: 1.25rem; padding-bottom: 2.5rem; }
    .page-meta { align-items: flex-start; flex-direction: column; margin-bottom: 1.75rem; gap: 1.5rem; }
    .scenario { gap: .65rem; font-size: .75rem; }
    h1 { font-size: clamp(1.85rem, 7.2vw, 2.5rem); }
    .lead { font-size: .95rem; line-height: 1.75; }
    .demo-context { padding: 1.1rem 0; margin-top: 1.25rem; font-size: .75rem; }
    figcaption { flex-direction: column; }
    .findings { display: block; padding: 1.25rem; }
    .finding-outcome { border-left: 0; border-top: 1px solid var(--border); padding: 1rem 0 0; margin-top: 1rem; }
    h2 { font-size: 1.3rem; }
    .wfo-demo > .capabilities { padding-top: 2rem; margin: 2rem 0; }
    .wfo-demo > .review, .wfo-demo > .closing { grid-template-columns: 1fr; gap: 2rem; padding-top: 2rem; margin-top: 2rem; }
    .more-demos { border-left: 0; border-top: 1px solid var(--border); padding: 1.75rem 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    summary :global(svg) { transition: none; }
  }
</style>
