---
interface Step {
  actor: string;
  title: string;
  desc: string;
}

interface Props {
  label: string;
  steps: Step[];
  note?: string;
  headingLevel?: 2 | 3;
}

const { label, steps, note, headingLevel } = Astro.props;
---

<div class="flow-diagram article-illustration">
  <div class="diagram-bar">
    {headingLevel === 2 ? (
      <h2 class="diagram-label">{label}</h2>
    ) : headingLevel === 3 ? (
      <h3 class="diagram-label">{label}</h3>
    ) : (
      <span class="diagram-label">{label}</span>
    )}
    {note && <span class="diagram-note">{note}</span>}
  </div>
  <div class="flow-track">
    {steps.map((step, i) => (
      <>
        <div class="flow-step">
          <div class="step-num">{i + 1}</div>
          <div class="step-content">
            <span class="step-actor">{step.actor}</span>
            <strong class="step-title">{step.title}</strong>
            <p class="step-desc">{step.desc}</p>
          </div>
        </div>
        {i < steps.length - 1 && (
          <div class="flow-arrow" aria-hidden="true"></div>
        )}
      </>
    ))}
  </div>
</div>

<style>
  .flow-diagram {
    width: min(100%, var(--case-flow-width, 1040px));
    margin: 1.5rem auto 2.5rem;
    border: 1px solid rgba(108,92,231,0.14);
    border-radius: 10px;
    background: rgba(18,18,42,0.36);
    overflow: hidden;
  }

  .diagram-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
    background: rgba(108,92,231,0.1);
    border-bottom: 1px solid rgba(108,92,231,0.14);
  }

  .diagram-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent2);
    margin: 0;
    line-height: 1;
  }

  .diagram-note {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1;
  }

  .flow-track {
    display: flex;
    align-items: flex-start;
    padding: 1.5rem 1.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .flow-track::-webkit-scrollbar { display: none; }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 130px;
    text-align: center;
  }

  .step-num {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: center;
  }

  .step-actor {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent2);
  }

  .step-title {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text);
    display: block;
  }

  .step-desc {
    font-size: 0.88rem;
    color: #fcf0e0;
    line-height: 1.5;
    margin: 0;
    max-width: 155px;
  }

  .flow-arrow {
    flex-shrink: 0;
    width: 2rem;
    align-self: center;
    margin-bottom: 3.5rem;
    position: relative;
  }
  .flow-arrow::after {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
  }
  .flow-arrow::before {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%) translateX(0);
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--accent2);
    margin-top: 0.5px;
  }

  @media (max-width: 768px) {
    .flow-track {
      flex-direction: column;
      padding: 1rem 1.25rem;
    }

    .flow-step {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      min-width: unset;
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .step-content { align-items: flex-start; }
    .step-desc { max-width: none; }

    .flow-arrow {
      width: 1px;
      height: 1.5rem;
      align-self: flex-start;
      margin-left: 1.1rem;
      margin-bottom: 0;
    }
    .flow-arrow::after {
      width: 1px;
      height: 100%;
      background: linear-gradient(180deg, var(--accent), var(--accent2));
    }
    .flow-arrow::before {
      right: unset;
      left: 50%;
      top: unset;
      bottom: 0;
      transform: translateX(-50%) translateY(0);
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 6px solid var(--accent2);
      border-bottom: none;
    }
  }
</style>
