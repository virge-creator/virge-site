---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../i18n';
import { getOtherLang } from '../i18n';
import { getAlternateSlug } from '../data/blog-slugs';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description = 'Virge.io Software solutions in AI, SDN, and eCommerce that scale with your business.', lang = 'en' } = Astro.props;
const otherLang = getOtherLang(lang);
const currentPath = Astro.url.pathname;

// Build alternate path with blog slug translation
let alternatePath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);
const blogPrefix = `/${lang}/blog/`;
const altBlogPrefix = `/${otherLang}/blog/`;
if (currentPath.startsWith(blogPrefix) && currentPath !== blogPrefix) {
  const slug = currentPath.replace(blogPrefix, '').replace(/\/$/, '');
  if (slug) {
    const altSlug = getAlternateSlug(slug, lang);
    alternatePath = `${altBlogPrefix}${altSlug}/`;
  }
}
// Handle jobs/vacatures
if (lang === 'en') {
  alternatePath = alternatePath.replace(`/${otherLang}/jobs/`, `/${otherLang}/vacatures/`);
} else {
  alternatePath = alternatePath.replace(`/${otherLang}/vacatures/`, `/${otherLang}/jobs/`);
}

const canonicalURL = new URL(currentPath, 'https://virge.io').href;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Virge.io`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang={lang} href={`https://virge.io${currentPath}`} />
  <link rel="alternate" hreflang={otherLang} href={`https://virge.io${alternatePath}`} />
  <title>{title} | Virge.io</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <Nav lang={lang} />
  <main><slot /></main>
  <Footer lang={lang} />
</body>
</html>
